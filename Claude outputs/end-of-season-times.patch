diff --git a/agent-tasks/out/fix-end-of-season-dates.mjs b/agent-tasks/out/fix-end-of-season-dates.mjs
new file mode 100644
index 0000000..e39006c
--- /dev/null
+++ b/agent-tasks/out/fix-end-of-season-dates.mjs
@@ -0,0 +1,55 @@
+// One-off correction of three end-of-season events in data/calendar.json.
+// Run from the repo root: node fix-dates.mjs   (then: npm run gen:series)
+import { readFileSync, writeFileSync } from 'node:fs';
+const CAL = 'data/calendar.json';
+const raw = readFileSync(CAL, 'utf8');
+const cal = JSON.parse(raw);
+if (JSON.stringify(cal, null, 2) + '\n' !== raw) throw new Error('calendar.json is not in canonical formatting: stop');
+const hl = (t) => `<span class="hl">${t}</span>`;
+const find = (year, weekLabel, series, title) => {
+  const hits = [];
+  for (const month of cal) if (month.year === year) for (const week of month.weeks) if (week.label === weekLabel) {
+    week.events.forEach((ev, i) => { if (ev.series === series && ev.title === title) hits.push({ week, i, ev }); });
+  }
+  if (hits.length !== 1) throw new Error(`expected exactly one ${series} "${title}" in ${weekLabel}, found ${hits.length}`);
+  return hits[0];
+};
+const weekOf = (year, label) => {
+  const w = cal.filter(m => m.year === year).flatMap(m => m.weeks).filter(w => w.label === label);
+  if (w.length !== 1) throw new Error(`expected exactly one week "${label}", found ${w.length}`);
+  return w[0];
+};
+
+// 1. Supercars: the bp Adelaide Grand Final is 26–29 November, not 3–6 December.
+//    Source: https://www.supercars.com/events/2026-adelaide (races Fri 16:20, Sat 15:20, Sun 15:15 ACDT).
+{
+  const { week, i, ev } = find(2026, 'WEEK 49 • DEC 03-06', 'supercars', 'bp Adelaide Grand Final');
+  if (ev.date !== '2026-12-06T03:30:00+01:00') throw new Error('Adelaide: unexpected current date ' + ev.date);
+  week.events.splice(i, 1);
+  ev.time = `FRI R: ${hl('06:50')} • SAT R: ${hl('05:50')} • SUN R: ${hl('05:45')}`;
+  ev.date = '2026-11-29T05:45:00+01:00';
+  ev.start = '2026-11-26';
+  ev.end = '2026-11-29';
+  weekOf(2026, 'WEEK 48 • NOV 27-29').events.push(ev);
+}
+
+// 2. F1 Academy Las Vegas: two races, Saturday and Sunday Paris time (was "RACES: 00:00", dated at the F1 race).
+//    Source: formula1.com Las Vegas GP timetable (Fri 18:15 and Sat 16:20 local).
+{
+  const { ev } = find(2026, 'WEEK 47 • NOV 19-22', 'f1a', 'Rd 7: Las Vegas (Finale)');
+  if (ev.date !== '2026-11-22T05:00:00+01:00') throw new Error('F1 Academy: unexpected current date ' + ev.date);
+  ev.time = `SAT R1: ${hl('03:15')} • SUN R2: ${hl('01:20')}`;
+  ev.date = '2026-11-22T01:20:00+01:00';
+}
+
+// 3. Super Formula Suzuka: a double-header, Round 11 on Saturday and Round 12 on Sunday (was one race at 05:00, dated 06:00).
+//    Source: https://www.suzukacircuit.jp/eng/superformula/2/schedule/ (14:25 and 13:50 Japan time).
+{
+  const { ev } = find(2026, 'WEEK 47 • NOV 19-22', 'sf', 'Suzuka II');
+  if (ev.date !== '2026-11-22T06:00:00+01:00') throw new Error('Super Formula: unexpected current date ' + ev.date);
+  ev.time = `SAT R11: ${hl('06:25')} • SUN R12: ${hl('05:50')}`;
+  ev.date = '2026-11-22T05:50:00+01:00';
+}
+
+writeFileSync(CAL, JSON.stringify(cal, null, 2) + '\n');
+console.log('calendar.json: 3 events corrected (Supercars Adelaide moved to week 48, F1 Academy Las Vegas, Super Formula Suzuka II)');
diff --git a/agent-tasks/out/fix-f2-detail.mjs b/agent-tasks/out/fix-f2-detail.mjs
new file mode 100644
index 0000000..76ea3bd
--- /dev/null
+++ b/agent-tasks/out/fix-f2-detail.mjs
@@ -0,0 +1,19 @@
+// F2 support rows at the last two F1 rounds: say which race the time chip is for, and name the sprint.
+// Sources: the formula1.com timetables for the Qatar and Abu Dhabi Grands Prix (already on each row as `source`).
+import { readFileSync, writeFileSync } from 'node:fs';
+const CAL = 'data/calendar.json';
+const raw = readFileSync(CAL, 'utf8');
+const cal = JSON.parse(raw);
+if (JSON.stringify(cal, null, 2) + '\n' !== raw) throw new Error('calendar.json is not in canonical formatting: stop');
+const set = (title, from, time, to) => {
+  const hits = cal.filter(m => m.year === 2026).flatMap(m => m.weeks).flatMap(w => w.events)
+    .filter(e => e.series === 'f1' && e.title === title);
+  if (hits.length !== 1) throw new Error(`${title}: found ${hits.length}`);
+  const f2 = (hits[0].sub ?? []).find(s => s.badge === 'f2');
+  if (!f2 || f2.detail !== from || f2.time !== time) throw new Error(`${title}: F2 row is not as expected: ${JSON.stringify(f2)}`);
+  f2.detail = to;
+};
+set('Qatar GP', 'RACES: TBC', '13:00', 'SPRINT: SAT 17:15 · FEATURE RACE');
+set('Abu Dhabi GP', 'FINALE: TBC', '10:15', 'FINALE · SPRINT: SAT 13:15 · FEATURE RACE');
+writeFileSync(CAL, JSON.stringify(cal, null, 2) + '\n');
+console.log('calendar.json: F2 support rows at Qatar and Abu Dhabi now name the sprint and the feature race');

+  color: var(--text-faint);
+  margin: 0 0 10px;
+}
+
+.standings-rows {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+}
+
+.standings-head {
+  display: grid;
+  grid-template-columns: 36px 1fr 80px;
+  gap: 0 12px;
+  padding: 4px 14px 8px;
+}
+
+.standings-head > div {
+  font-family: var(--font-mono);
+  font-size: var(--fs-2xs);
+  color: var(--text-faint);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.standings-head .st-pts { text-align: right; }
+
+.standings-row {
+  display: grid;
+  grid-template-columns: 36px 1fr 80px;
+  gap: 0 12px;
+  align-items: center;
+  background: var(--card-bg);
+  border: 1px solid var(--border);
+  padding: 10px 14px;
+  border-radius: var(--radius-xl);
+}
+
+.standings-row--lead {
+  border-color: var(--line-subtle-5);
+  background: var(--card-bg-2);
+}
+
+.standings-row:hover {
+  background: var(--card-bg-2);
+  border-color: var(--line-subtle-5);
+}
+
+.st-pos {
+  font-family: var(--font-mono);
+  font-size: var(--fs-sm);
+  font-weight: 700;
+  color: var(--text-faint);
+  text-align: center;
+}
+
+/* --accent is a border colour (3.5:1 on the card in dark); the bright tier
+   keeps the blue and passes AA as text in both themes (9.2:1 dark, 6.3:1 light). */
+.standings-row--lead .st-pos {
+  color: var(--accent-bright);
+}
+
+.st-name {
+  min-width: 0;
+}
+
+.st-name-inner {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.st-flag {
+  width: 18px;
+  height: 13px;
+  object-fit: cover;
+  border-radius: var(--radius-xs);
+  flex-shrink: 0;
+}
+
+.st-driver {
+  font-size: var(--fs-base);
+  font-weight: 600;
+  color: var(--text-soft);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.standings-row--lead .st-driver {
+  color: var(--text-strong-3);
+}
+
+.st-team {
+  font-family: var(--font-mono);

# dord.racing — environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored and never leaves your machine,
# so it does NOT transfer when you clone the repo somewhere new — that is the one
# thing you have to move by hand between machines.
#
# In production these are set in the Cloudflare dashboard, not from this file:
#   Site    → Cloudflare Pages → Settings → Environment Variables
#   Worker  → cd workers && wrangler secret put <NAME>
#
# The calendar, tracks, series and results pages need NONE of this. It is only
# required for the newsletter (signup, unsubscribe, weekly send).

# ── Affiliate links ──────────────────────────────────────────────────────────
# "true" activates Awin tracking on the Plan Your Trip links. Leave false until
# the programmes are approved — links still work, they just don't earn.
# See agent-tasks/affiliate-links-instructions.md
PUBLIC_AFFILIATE_LINKS_ENABLED=false

# ── Newsletter: Resend (transactional email) ─────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@dord.racing

# ── Newsletter: Turso (subscriber database) ──────────────────────────────────
# Schema lives in db/schema.sql — run once:
#   npx turso db shell dord-subscribers < db/schema.sql
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# ── Signing secrets ──────────────────────────────────────────────────────────
# UNSUB_SECRET signs one-click unsubscribe tokens (test with npm run test:unsub).
# CRON_SECRET authenticates the weekly send trigger.
# Generate each with:  openssl rand -hex 32
UNSUB_SECRET=
CRON_SECRET=

---
import { FAQS } from '../lib/faq';
---
<div class="faq-section">
  <div class="faq-header-title">FAQ</div>
  <div class="faq-grid">
    {FAQS.map(faq => (
      <details class="faq-card" name="faq">
        <summary class="faq-question">{faq.question}</summary>
        <div class="faq-answer"><p>{faq.answer}</p></div>
      </details>
    ))}
  </div>
</div>

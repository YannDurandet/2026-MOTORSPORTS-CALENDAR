---
/**
 * One race in a calendar week card (the "Event Row" component in Figma).
 *
 * Collapsed: chevron · series badge · title · time chip.
 * Expanded:  classes, session times, races, support series, result, track map, links.
 *
 * Hooks main.js depends on — keep them:
 *   .event[data-series]      filters
 *   .meta-time > .hl         timezone conversion (chip + sessions)
 *   .ev-toggle / .ev-panel   expand/collapse + week focus switch
 *   data-ts                  live-state detection
 */
import { findEvent } from '../lib/events';

interface SubRace { badge: string; label: string; detail: string; round?: string; day?: string; time?: string }
interface Race { label: string; time: string }
interface Session { day: string; label: string; time: string; duration?: string }
interface Result { winner?: string; winners?: string[]; team?: string; manufacturer?: string; race_label?: string }

interface Props {
  series: string;
  tag: string;
  title: string;
  time: string;
  track: string;
  date: string;
  weekLabel: string;
  year: number;
  sprint?: boolean;
  classes?: string[];
  sessions?: Session[];
  sub?: SubRace[];
  races?: Race[];
  results?: Result[];
  trackHref?: string | null;
}

const { series, tag, title, time, track, date, weekLabel, year, sprint, classes, sessions, sub, races, results, trackHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const seriesHref = `${base}/series/${series}`;
const eventPath = findEvent(year, series, title, weekLabel)?.path;
const panelId = `evp-${`${year}-${weekLabel.match(/WEEK (\d+)/)?.[1] ?? ''}-${series}-${title}`.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

// ── Time chip ────────────────────────────────────────────────────────────────
// Weekday comes from the event's date (Paris, the source timezone); the clock
// time is the last session time in the row — normally the main race. It is
// wrapped as .meta-time/.hl so main.js converts it with everything else.
const allTimes = [...(time ?? '').matchAll(/<span class="hl">(\d{2}:\d{2})<\/span>/g)].map(m => m[1]);
const lastTime = allTimes.at(-1) ?? (races ?? []).flatMap(r => [...r.time.matchAll(/<span class="hl">(\d{2}:\d{2})<\/span>/g)].map(m => m[1])).at(-1);
const weekday = new Date(date).toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'Europe/Paris' }).toUpperCase();
const plain = (time ?? '').replace(/<[^>]+>/g, '').trim();
const chipHtml = lastTime
  ? `${weekday} <span class="hl">${lastTime}</span>`
  : /TBC/.test(plain) ? `${weekday} TBC` : plain.replace(/\s*>\s*/, '–');
const isTbc = !lastTime;

// ── Session schedule ─────────────────────────────────────────────────────────
// Optional `sessions` replaces the single TIMES line / race legs with one line
// per day ("SAT  FP 15:10 · Qualifying 21:35"). Consecutive sessions on the
// same day share a line. `time` stays the source for the chip and countdowns.
const sessionDays = (sessions ?? []).reduce<{ day: string; items: Session[] }[]>((days, s) => {
  const last = days.at(-1);
  if (last?.day === s.day) last.items.push(s);
  else days.push({ day: s.day, items: [s] });
  return days;
}, []);
const hasSessions = sessionDays.length > 0;

const winnerOf = (r: Result) => r.winners?.length ? r.winners.join(' · ') : (r.winner ?? '');
const finished = !!results?.length;
---
<div
  class:list={['event', 'ev-row', `ev-${series}`, { 'is-finished': finished, 'is-tbc': isTbc }]}
  data-series={series}
  data-ts={date}
>
  <div class="ev-head">
    <button
      class="ev-toggle"
      aria-expanded="false"
      aria-controls={panelId}
      aria-label={`${tag} ${title} — show details`}
    >
      <svg class="ev-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <a href={seriesHref} class={`tag t-${series}`}>{tag}</a>
    <span class="title">{title}</span>
    {sprint && <span class="class-tag">SPRINT</span>}
    <span class="time-chip meta-time" class:list={{ 'is-muted': finished || isTbc }}>
      <span class="live-flag" hidden>LIVE</span>
      <Fragment set:html={chipHtml} />
    </span>
  </div>

  <div class="ev-panel" id={panelId} hidden="until-found">
    <div class="ev-panel-body">
      <div class="ev-panel-main">
        {classes && classes.length > 0 && (
          <ul class="class-chips" aria-label="Classes">
            {classes.map(c => <li class="class-chip">{c}</li>)}
          </ul>
        )}
        {hasSessions && sessionDays.map(g => (
          <div class="session-line">
            {/* The day label sits inside .meta-time on purpose: timezone
                conversion reads the nearest day token to pick the right UTC
                offset on daylight-saving weekends. */}
            <span class="session-row meta-time">
              <span class="session-day">{g.day}</span>
              <span class="session-items">
                {g.items.map((s, i) => (
                  <>
                    {i > 0 && <span class="session-sep" aria-hidden="true"> · </span>}
                    <span class="session-item">{s.label} <span class="hl">{s.time}</span>{s.duration && <span class="session-dur"> — {s.duration}</span>}</span>
                  </>
                ))}
              </span>
            </span>
          </div>
        ))}
        {!hasSessions && time && (
          <div class="session-line">
            <span class="session-day">TIMES</span>
            <span class="meta-time"><Fragment set:html={time} /></span>
          </div>
        )}
        {!hasSessions && races?.map(r => (
          <div class="session-line">
            <span class="session-day">{r.label}</span>
            <span class="meta-time"><Fragment set:html={r.time} /></span>
          </div>
        ))}
        {finished && results!.map(r => (
          <div class="ev-result">
            <span class="session-day">{r.race_label ?? 'WINNER'}</span>
            <span class="ev-winner">{winnerOf(r)}</span>
            {(r.team ?? r.manufacturer) && <span class="ev-team">{r.team ?? r.manufacturer}</span>}
          </div>
        ))}
      </div>
      {track && (
        trackHref
          ? <a href={trackHref} class="ev-map" aria-label={`${title} circuit guide`}>
              <img src={`${base}/assets/track-maps/${track}`} alt="" loading="lazy" width="56" height="56" />
            </a>
          : <span class="ev-map"><img src={`${base}/assets/track-maps/${track}`} alt="" loading="lazy" width="56" height="56" /></span>
      )}
    </div>

    {sub && sub.length > 0 && (
      <div class="ev-support">
        {sub.map(s => (
          <div class="support-lane">
            <span class={`badge b-${s.badge}`}>{s.label}</span>
            <span class="support-detail">{[s.round, s.detail].filter(Boolean).join(' · ')}</span>
            {s.day && s.time && (
              <span class="time-chip is-muted meta-time">{s.day} <span class="hl">{s.time}</span></span>
            )}
          </div>
        ))}
      </div>
    )}

    <div class="ev-links">
      {eventPath && <a href={`${base}${eventPath}`}>Event page →</a>}
      {trackHref && <a href={trackHref}>Circuit guide →</a>}
    </div>
  </div>

  {track && <img class="ev-ghost" src={`${base}/assets/track-maps/${track}`} alt="" aria-hidden="true" loading="lazy" width="96" height="96" />}
</div>

---
/**
 * GettingThereCard — "Getting There" logistics module for track detail pages.
 *
 * Renders the `logistics` block from data/tracks.json: nearest airport, the
 * transport route from it, where to base yourself, and one insider tip.
 *
 * `affiliate_hooks` render as non-interactive keyword chips. They are on-page
 * intent signals (and the vocabulary real fans search with) — the monetised
 * CTAs live in <TripPlannerCard />, which sits directly below this card and is
 * targeted at `accommodation_hub` rather than the venue city. Keeping one
 * affiliate module on the page avoids two competing sets of outbound links.
 */
export interface TrackLogistics {
  nearest_airport: string;
  transport: string;
  accommodation_hub: string;
  travel_tip: string;
  affiliate_hooks: string[];
}

interface Props {
  logistics: TrackLogistics;
}

const { logistics } = Astro.props;

const rows = [
  { icon: '✈️', label: 'NEAREST AIRPORT', value: logistics.nearest_airport, mono: true },
  { icon: '\u{1F686}',    label: 'GETTING IN',      value: logistics.transport,       mono: false },
  { icon: '\u{1F3E8}',    label: 'BASE YOURSELF',   value: logistics.accommodation_hub, mono: false },
];
---

<div class="getting-there">
  <div class="section-label">GETTING THERE</div>

  <dl class="gt-rows">
    {rows.map(r => (
      <div class="gt-row">
        <dt class="gt-term">
          <span class="gt-icon" aria-hidden="true">{r.icon}</span>
          <span class="gt-label">{r.label}</span>
        </dt>
        <dd class:list={["gt-value", { "gt-value--mono": r.mono }]}>{r.value}</dd>
      </div>
    ))}
  </dl>

  <div class="gt-tip">
    <div class="gt-tip-label">INSIDER TIP</div>
    <p class="gt-tip-text">{logistics.travel_tip}</p>
  </div>

  {logistics.affiliate_hooks.length > 0 && (
    <ul class="gt-hooks" aria-label="Related travel searches">
      {logistics.affiliate_hooks.map(hook => (
        <li class="gt-hook">{hook}</li>
      ))}
    </ul>
  )}
</div>

<style>
  .getting-there {
    border: 1px solid var(--border);
    background: var(--card-bg);
    padding: 20px 24px;
    margin-bottom: 2px;
  }

  /* Mirrors .section-label on the track detail page */
  .section-label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.6rem;
    color: #7a8fa0;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .gt-rows {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .gt-row {
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
  }

  .gt-row:first-child { padding-top: 0; }
  .gt-row:last-child  { border-bottom: none; }

  .gt-term {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
  }

  .gt-icon {
    font-size: 0.8rem;
    line-height: 1;
    width: 16px;
    text-align: center;
    flex-shrink: 0;
  }

  .gt-label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.6rem;
    color: #7a8fa0;
    letter-spacing: 0.08em;
  }

  .gt-value {
    margin: 0 0 0 24px;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #8a9aaa;
  }

  .gt-value--mono {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.78rem;
    color: #c3c6c8;
    letter-spacing: 0.02em;
  }

  /* ── Insider tip ─────────────────────────────────────────────────────────── */
  .gt-tip {
    margin-top: 16px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-left: 2px solid #7a8fa0;
    background: var(--bg);
  }

  .gt-tip-label {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.58rem;
    color: #7a8fa0;
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .gt-tip-text {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: #8a9aaa;
  }

  /* ── Search-intent keywords ──────────────────────────────────────────────── */
  .gt-hooks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .gt-hook {
    font-family: 'Roboto Mono', monospace;
    font-size: 0.6rem;
    color: #7a8fa0;
    letter-spacing: 0.04em;
    border: 1px solid var(--border);
    padding: 4px 8px;
  }
</style>

---
// NewsletterForm.astro — the ONE newsletter sign-up form.
// Used by newsletter.astro and NewsletterBanner.astro (F-068): markup, styles
// and submit script live here only. Posts to /api/subscribe (src/pages/api/subscribe.ts).
---

<div class="nl-form-wrap">
  <form class="nl-form" id="nl-form" novalidate>
    <div class="nl-row">
      <label for="nl-email" class="sr-only">Email address</label>
      <input
        type="email"
        id="nl-email"
        name="email"
        class="nl-input"
        placeholder="your@email.com"
        autocomplete="email"
        required
        aria-describedby="nl-error"
      />
      <button type="submit" class="nl-btn" id="nl-btn">
        <span id="nl-btn-label">SUBSCRIBE</span>
        <span id="nl-btn-loading" hidden aria-hidden="true">···</span>
      </button>
    </div>
    <p class="nl-error" id="nl-error" role="alert" hidden></p>
  </form>
  <p class="nl-success" id="nl-success" role="status" tabindex="-1" hidden>
    You're in. First briefing lands before the weekend.
  </p>
  <p class="nl-fine">Free. Weekly. Unsubscribe any time.</p>
</div>

<style>
  .nl-form-wrap { width: 100%; max-width: 420px; }

  .nl-row {
    display: flex;
    width: 100%;
  }

  .nl-input {
    flex: 1;
    background: var(--surface-sunken-5);
    border: 1px solid var(--border);
    border-right: none;
    border-radius: var(--radius-pill) 0 0 var(--radius-pill);
    color: var(--text-soft);
    font-family: var(--font-mono);
    font-size: var(--fs-sm-3);
    letter-spacing: 0.02em;
    padding: 13px 16px;
    outline: none;
    min-width: 0;
    transition: border-color 0.15s;
  }
  .nl-input::placeholder { color: var(--text-faint-3); }
  .nl-input:focus { border-color: var(--accent-bright); box-shadow: 0 0 0 1px var(--accent-bright); }

  .nl-btn {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 13px 20px;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-soft);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    border-radius: 0 var(--radius-pill) var(--radius-pill) 0;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .nl-btn:hover:not(:disabled) {
    color: var(--text-strong);
    border-color: var(--accent);
    background: var(--card-bg-9);
  }
  .nl-btn:disabled { opacity: 0.45; cursor: wait; }

  .nl-error {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs-6);
    color: var(--error);
    letter-spacing: 0.03em;
    margin: 8px 0 0;
  }
  .nl-error[hidden] { display: none; }

  .nl-success {
    font-family: var(--font-mono);
    font-size: var(--fs-sm-3);
    color: var(--success);
    letter-spacing: 0.02em;
    line-height: 1.6;
    margin: 0;
  }
  .nl-success[hidden] { display: none; }

  .nl-fine {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs-4);
    color: var(--text-faint-3);
    letter-spacing: 0.06em;
    margin: 12px 0 0;
  }

  @media (min-width: 769px) {
    .nl-form-wrap { max-width: 460px; }
  }
</style>

<script>
  const form       = document.getElementById('nl-form')      as HTMLFormElement | null;
  const emailInput = document.getElementById('nl-email')     as HTMLInputElement | null;
  const btn        = document.getElementById('nl-btn')       as HTMLButtonElement | null;
  const btnLabel   = document.getElementById('nl-btn-label');
  const btnLoading = document.getElementById('nl-btn-loading');
  const errorMsg   = document.getElementById('nl-error');
  const successMsg = document.getElementById('nl-success');
  const fineMsg    = document.querySelector('.nl-fine')      as HTMLElement | null;

  function setLoading(on: boolean) {
    if (!btn) return;
    btn.disabled = on;
    if (btnLabel)   btnLabel.hidden   = on;
    if (btnLoading) btnLoading.hidden = !on;
  }

  function showError(msg: string) {
    if (!errorMsg) return;
    errorMsg.hidden = false;
    errorMsg.textContent = msg;
  }

  function showSuccess(msg: string) {
    if (form)       form.hidden       = true;
    if (fineMsg)    fineMsg.hidden    = true;
    if (successMsg) {
      successMsg.hidden = false;
      successMsg.textContent = msg;
      successMsg.focus();
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput?.value.trim() ?? '';

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError('Please enter a valid email address.');
      emailInput?.focus();
      return;
    }

    if (errorMsg) errorMsg.hidden = true;
    setLoading(true);

    try {
      const res  = await fetch('/api/subscribe', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email }),
      });
      const data = (await res.json()) as { ok?: boolean; pending?: boolean; message?: string; error?: string };

      if (data?.ok && data.pending) {
        // Double opt-in: nothing is subscribed until the emailed link is used.
        showSuccess(data.message ?? 'Check your inbox to confirm your address.');
      } else if (data?.ok) {
        window.location.href = '/newsletter/thank-you';
      } else {
        setLoading(false);
        showError(data?.error ?? 'Something went sideways. Try again.');
      }
    } catch {
      // Network failure or a non-JSON reply: the raw exception text
      // ("Failed to fetch", "Unexpected token '<'") means nothing to a reader.
      setLoading(false);
      showError('Something went sideways. Try again.');
    }
  });
</script>

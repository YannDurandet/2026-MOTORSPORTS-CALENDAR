---
import NewsletterForm from './NewsletterForm.astro';

// NewsletterBanner.astro
// Inserted into the main calendar at the current-month boundary (see index.astro).
// The form itself is the shared NewsletterForm.astro (posts to /api/subscribe).
---


<section class="nl-banner theme-dark" aria-label="Newsletter signup">
  <picture class="nl-bg">
    <source media="(min-width: 769px)" srcset="/assets/mailing-banner-desktop.webp" width="1500" height="500" />
    <img src="/assets/mailing-banner-mobile.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" width="500" height="1036" />
  </picture>
  <div class="nl-inner">
    <p class="nl-headline">FROM THE <br>PIT WALL</p>
    <div class="nl-content-row">
      <div class="nl-text">
        <p class="nl-body">A weekly briefing from The Department of Racing Drivers. What's on, where it is, and why the next three days are going to be chaos.</p>
        <a class="nl-more" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/newsletter`}>What's in it →</a>
      </div>

      <NewsletterForm />
    </div>
  </div>
</section>

<style>
  /* ── Wrapper ─────────────────────────────────────────────────────────────── */
  .nl-banner {
    position: relative;
    margin: 40px 0;
    border: 1px solid var(--row-line);
    border-radius: var(--radius-2xl);
    background-color: var(--surface-sunken-2); /* placeholder until the lazy image arrives */
    isolation: isolate; /* keeps the z-index:-1 image above this background, below the scrim */
    overflow: hidden;
    /* Mobile: full viewport height so the banner is a dedicated scroll moment */
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  /* Cover image as a lazy <img> layer (a CSS background would be fetched eagerly,
     even though the banner sits below the fold). */
  .nl-bg {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .nl-bg img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Dark scrim so text stays legible over the image */
  .nl-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-banner);
    pointer-events: none;
  }

  /* ── Inner layout ────────────────────────────────────────────────────────── */
  .nl-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 80px 24px;
  }

  /* Mobile: content row is also a column */
  .nl-content-row {
    display: flex;
    flex-direction: column;
    gap: 48px;
    width: 100%;
  }

  /* ── Text block ──────────────────────────────────────────────────────────── */
  .nl-headline {
    font-family: var(--font-title);
    font-size: var(--fs-display);
    font-weight: 900;
    color: var(--text-soft);
    line-height: 0.9;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }

  .nl-body {
    font-family: var(--font-mono);
    font-size: var(--fs-sm-3);
    color: var(--text-muted);
    letter-spacing: 0.02em;
    line-height: 1.75;
    margin: 0;
    max-width: 48ch;
  }
  .nl-more {
    display: inline-block;
    margin-top: 8px;
    padding: 4px 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-soft);
  }
  .nl-more:hover { color: var(--text-strong); }
  .nl-more:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }

  /* ── Desktop: centered band ──────────────────────────────────────────────── */
  @media (min-width: 769px) {
    .nl-banner {
      min-height: auto;
    }

    /* Centered uniform scrim for centered layout */
    .nl-banner::before {
      background: var(--scrim-banner-flat);
    }

    .nl-inner {
      flex-direction: column;
      align-items: center;
      gap: 40px;
      padding: 80px 48px;
    }

    /* Title on one line, centered */
    .nl-headline {
      text-align: center;
      margin-bottom: 0;
    }
    .nl-headline br {
      display: none;
    }

    /* Desc + form side by side, centered */
    .nl-content-row {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: 56px;
      width: auto;
      max-width: 960px;
    }

    .nl-text {
      flex: 0 0 auto;
      max-width: 360px;
    }
  }
</style>


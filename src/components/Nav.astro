---
interface Props {
  activePage: 'calendar' | 'series' | 'tracks' | 'results' | 'watch';
}
const { activePage } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="site-nav" id="site-nav">
  <a href={`${base}/`} class:list={["site-nav-link", { active: activePage === 'calendar' }]}>Calendar</a>
  <a href={`${base}/series`} class:list={["site-nav-link", { active: activePage === 'series' }]}>Series</a>
  <a href={`${base}/tracks`} class:list={["site-nav-link", { active: activePage === 'tracks' }]}>Tracks</a>
  <a href={`${base}/results`} class:list={["site-nav-link", { active: activePage === 'results' }]}>Results</a>
  <a href={`${base}/watch`} class:list={["site-nav-link", { active: activePage === 'watch' }]}>Watch</a>
  <button class="search-trigger" id="search-trigger" aria-label="Search (/)">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14" aria-hidden="true">
      <circle cx="8.5" cy="8.5" r="5.5"/>
      <line x1="13" y1="13" x2="17" y2="17"/>
    </svg>
  </button>
  <!-- Switch: label stays "Dark mode", aria-pressed says whether it is on (BaseLayout script keeps it
       current). The icon shows the theme on screen. -->
  <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="true" title="Switch light / dark theme">
    <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
    <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true">
      <circle cx="12" cy="12" r="5"/>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
  </button>
</nav>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 32px;
    background: none;
    border: 0;
    border-radius: var(--radius-xl);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0 10px;
    transition: color 0.15s, background 0.15s;
  }
  .theme-toggle:hover {
    color: var(--text-strong);
    background: var(--row-bg-open);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .theme-toggle .i-sun { display: none; }
  :global(:root[data-theme="light"]) .theme-toggle .i-sun { display: block; }
  :global(:root[data-theme="light"]) .theme-toggle .i-moon { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle { transition: none; }
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    min-height: 32px;
    background: none;
    border: 0;
    border-radius: var(--radius-xl);
    color: var(--text-muted);
    cursor: pointer;
    padding: 0 10px;
    margin-left: 2px;
    transition: color 0.15s, background 0.15s;
  }
  .search-trigger:hover {
    color: var(--text-strong);
    background: var(--row-bg-open);
  }
  .search-trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
</style>

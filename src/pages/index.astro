---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/calendar.css';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import EventRow from '../components/EventRow.astro';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';

// Import data at build time
import calendarData from '../../data/calendar.json';
import seriesContent from '../../data/seriesContent.json';
import seriesIndex from '../../data/series.json';
import { ALL_EVENTS, trackSlugForSvg } from '../lib/events';
import { DEFAULT_CALENDAR_YEAR, monthYear } from '../lib/season';
import { seriesShort } from '../lib/seriesShort';
import { jsonForScript } from '../lib/jsonForScript';
import { withTbcFlags } from '../lib/tbc';
import { FAQS } from '../lib/faq';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Races whose start time isn't published carry `tbc: true` (see src/lib/tbc.ts).
const seriesIndexJson = jsonForScript(withTbcFlags(seriesIndex));

// Find the calendar index of the current month so we can inject the newsletter
// banner directly after it. Position is set at build time; the site is rebuilt
// weekly for results anyway, so this stays current.
const _today = new Date();
const _monthNames = ['january','february','march','april','may','june','july','august','september','october','november','december'];
const newsletterAfterIdx = (calendarData as any[]).findIndex((m: any) =>
  m.month.toLowerCase().includes(_monthNames[_today.getMonth()]) && monthYear(m) === _today.getFullYear()
);

// Next season's published calendars, as plain links: the in-page 2027 preview
// is a JS toggle, so without these nothing crawlable points at 2027.
const nextYear = DEFAULT_CALENDAR_YEAR + 1;
// Week-card ids already given out: a week split across two months has two cards.
const usedCardIds = new Set<string>();
const SEASON_ORDER = ['f1', 'motogp', 'wec', 'fe', 'imsa', 'indycar', 'wrc', 'wsbk'];
const nextSeasonSeries = [...new Set(ALL_EVENTS.filter(e => e.year === nextYear).map(e => e.series))]
  .sort((a, b) => {
    const ia = SEASON_ORDER.indexOf(a), ib = SEASON_ORDER.indexOf(b);
    return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b);
  })
  .map(slug => ({
    slug,
    label: seriesShort(slug, (seriesContent as any[]).find(s => s.slug === slug)?.name),
  }));

const enrichedCalendar = (calendarData as any[]).map((month: any) => ({
  ...month,
  weeks: month.weeks.map((week: any) => ({
    ...week,
    events: week.events.map((ev: any) => {
      // The circuit page comes from tracks.json, as on event pages; the SVG's
      // file name is not a reliable guide (madrid-f1.svg is not Jarama).
      const slug = trackSlugForSvg(ev.track);
      const trackHref = slug ? `${base}/tracks/${slug}` : null;
      return { ...ev, trackHref };
    }),
  })),
}));

---
<BaseLayout
  title="2026 Motorsport Calendar — F1, MotoGP, WEC & 23 More | DORD"
  description="The ultimate 2026 motorsport master calendar. Track F1, WEC, IMSA, MotoGP, IndyCar, and more with live countdowns and local track times."
  canonicalUrl="https://dord.racing"
  ogImage="https://dord.racing/assets/og/og-home.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "DORD Racing",
      "alternateName": "The Department of Racing Drivers",
      "url": "https://dord.racing",
      "logo": "https://dord.racing/assets/og/og-home.webp",
      "sameAs": [
        "https://x.com/dord_racing",
        "https://www.instagram.com/dord.racing/"
      ]
    })} />
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "2026 Motorsport Master Calendar",
      "alternateName": "dord.racing",
      "url": "https://dord.racing",
      "description": "The ultimate 2026 motorsport master calendar tracking 26 championships across open-wheel, endurance, touring, GT, bike, and rally series.",
      "publisher": {
        "@type": "Organization",
        "name": "DORD Racing",
        "url": "https://dord.racing"
      },
      "creator": {
        "@type": "Organization",
        "name": "Durandet Studio",
        "url": "https://durandet.studio"
      }
    })} />
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": FAQS.map(({ question, answer }) => ({
        "@type": "Question",
        "name": question,
        "acceptedAnswer": { "@type": "Answer", "text": answer }
      }))
    })} />
  </Fragment>

  <Banner />
  <header>
    <div class="header--left">
      <h1>2026 Motorsport<br>Master Calendar</h1>
      <div class="meta-tz-row">
        <div class="meta" id="tz-notice">SYSTEM TIMEZONE: PARIS (CET/CEST)</div>
        <label for="tz-select" class="tz-label">TZ</label>
        <select id="tz-select" class="tz-select" aria-label="Display timezone">
          <!-- Populated by main.js -->
        </select>
      </div>
      <div class="website-description">The ultimate 2026 motorsport master calendar. Track every race weekend
        across global and regional series, including Formula 1, WEC, IMSA, IndyCar, MotoGP, and WRC.<br> Use
        the filters to customize your schedule by open-wheel, endurance, or touring cars. All countdowns and
        schedules are localized to Paris CET/CEST time.</div>
      <Nav activePage="calendar" />
      {nextSeasonSeries.length > 0 && (
        <nav class="season-links" aria-label={`${nextYear} calendars`}>
          <span class="season-links-label">{nextYear} calendars</span>
          {nextSeasonSeries.map(s => (
            <a class="season-link" href={`${base}/series/${s.slug}/${nextYear}`}>{s.label} {nextYear}</a>
          ))}
        </nav>
      )}
    </div>
  </header>


  <main id="main-content" class="main-section">
    <div id="this-weekend" class="this-weekend-section" hidden>
      <div class="this-weekend-header" role="heading" aria-level="2">THIS WEEKEND</div>
      <div id="this-weekend-grid" class="this-weekend-grid"></div>
    </div>

    <div id="filter-bar" class="filter-bar">
      <fieldset class="filter-group" id="region-filters">
        <legend>Region</legend>
      </fieldset>
      <fieldset class="filter-group" id="category-filters">
        <legend>Category</legend>
      </fieldset>
      <details class="advanced-filters" id="advanced-filters">
        <summary>Advanced: Toggle Specific Series</summary>
        <div class="advanced-series-grid" id="series-toggles"></div>
      </details>
      <div class="filter-active-bar" id="filter-active-bar">
        <span class="filter-active-label">Filters active</span>
        <button class="clear-all-btn" id="clear-all-filters">Clear all ×</button>
      </div>
      <div class="cal-subscribe-bar">
        <button
          id="cal-subscribe-btn"
          class="subscribe-btn subscribe-btn--ical cal-subscribe-trigger"
          aria-haspopup="dialog"
          aria-label="Subscribe to my motorsport calendar"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Subscribe to my calendar
        </button>
      </div>
    </div>

    <!-- Personal iCal modal -->
    <div id="ical-modal" class="embed-modal" role="dialog" aria-modal="true" aria-labelledby="ical-modal-title" hidden>
      <div class="embed-modal-backdrop" id="ical-modal-backdrop"></div>
      <div class="embed-modal-box">
        <div class="embed-modal-header">
          <h4 class="embed-modal-title" id="ical-modal-title" aria-level="2">Subscribe to your calendar</h4>
          <button class="embed-modal-close" id="ical-modal-close" aria-label="Close calendar subscribe modal">&times;</button>
        </div>
        <p class="embed-modal-desc">Subscribe in your calendar app — events update automatically.</p>
        <div class="ical-link-row">
          <input
            type="text"
            id="ical-link-input"
            class="ical-link-input"
            readonly
            aria-label="Calendar subscription link"
          />
          <button class="embed-copy-btn" id="ical-copy-btn">Copy</button>
        </div>
        <div class="embed-modal-actions" style="margin-top: 0.75rem;">
          <a
            id="ical-gcal-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="subscribe-btn subscribe-btn--gcal"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            + Google Calendar
          </a>
          <span class="embed-checks">✓ Auto-updates &nbsp; ✓ Free</span>
        </div>
      </div>
    </div>

    <div id="empty-state" class="empty-state" hidden>
      <p>No events match your current filters.</p>
      <button id="clear-filters-btn" class="clear-filters-btn">Clear Filters</button>
    </div>

    <details id="past-events-container" class="past-events-accordion cal-v2">
      <summary id="past-events-summary">View Past Events</summary>
    </details>

    <div id="calendar-container" class="cal-v2">
      {enrichedCalendar.map((month: any, idx: number) => (
        <>
          <div class="month-header" role="heading" aria-level="2" data-year={monthYear(month)}>{month.month}{month.year ? ` ${month.year}` : ''}</div>
          <div class="cal-grid" data-year={monthYear(month)}>
            {month.weeks.map((week: any) => {
              const weekYear = monthYear(month);
              const weekNum = week.label.match(/WEEK (\d+)/)?.[1];
              // Ids are link targets (search, newsletter, shared links): later seasons are prefixed.
              const baseId = weekNum
                ? (weekYear === DEFAULT_CALENDAR_YEAR ? `week-${weekNum}` : `${weekYear}-week-${weekNum}`)
                : undefined;
              // The first card keeps "week-09" (what search and the newsletter link to);
              // the second card of a split week gets "week-09-b". check-data allows no third.
              const cardId = baseId && usedCardIds.has(baseId) ? `${baseId}-b` : baseId;
              if (cardId) usedCardIds.add(cardId);
              return (
              <div class="card wk-card" id={cardId}>
                <div class="wk-head">
                  <div class="c-head">
                    {cardId
                      ? <a class="week-anchor" href={`#${cardId}`} aria-label={`Link to ${week.label}`}><span class="wk-num">{week.label.split(' • ')[0]}</span><span class="wk-sep"> • </span><span class="wk-dates">{week.label.split(' • ')[1]}</span></a>
                      : week.label}
                  </div>
                  {week.events.length > 1 && (
                    <div class="focus-switch" role="group" aria-label={`Step through ${week.label} races`}>
                      <span class="focus-label" aria-hidden="true">FOCUS</span>
                      <button class="focus-btn" data-dir="-1" aria-label="Previous race">▲</button>
                      <button class="focus-btn" data-dir="1" aria-label="Next race">▼</button>
                    </div>
                  )}
                </div>
                <div class="c-body">
                  {week.events.map((ev: any) => (
                    <EventRow
                      series={ev.series}
                      tag={ev.tag}
                      title={ev.title}
                      time={ev.time}
                      track={ev.track}
                      date={ev.date}
                      weekLabel={week.label}
                      year={weekYear}
                      sprint={ev.sprint}
                      classes={ev.classes}
                      sessions={ev.sessions}
                      sub={ev.sub}
                      races={ev.races}
                      results={ev.results}
                      trackHref={ev.trackHref}
                    />
                  ))}
                </div>
              </div>
              );
            })}
          </div>
          {idx === newsletterAfterIdx && <NewsletterBanner />}
        </>
      ))}
    </div>

    <FAQ />
    <Footer />
  </main>

  <!-- Race dates for the "This Weekend" countdowns (generated: npm run gen:series).
       Inline so main.js renders the strip before first paint; /data/series.json
       remains the fallback. -->
  <script type="application/json" id="series-data" set:html={seriesIndexJson}></script>
  <script src="../scripts/main.js"></script>
</BaseLayout>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import TripPlannerCard from '../../components/TripPlannerCard.astro';
import GettingThereCard from '../../components/GettingThereCard.astro';
import { accommodationQuery } from '../../lib/affiliates';

// Vite reads these at bundle time — no node:fs needed, works in Cloudflare Workers prerender
// Options stay on one line: Astro's dev dependency scanner treats any
// frontmatter line starting with `import` as an import statement.
const _svgRaw = import.meta.glob('/public/assets/track-maps/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svgByFilename: Record<string, string> = {};
for (const [k, v] of Object.entries(_svgRaw)) {
  svgByFilename[k.split('/').pop()!] = v;
}
function readSvg(filename: string | undefined | null): string | null {
  if (!filename) return null;
  return svgByFilename[filename] ?? null;
}


import tracksRaw from '../../../data/tracks.json';
import calendarData from '../../../data/calendar.json';
import seriesContentData from '../../../data/seriesContent.json';
import { DEFAULT_CALENDAR_YEAR, monthYear, showOnTrackPages } from '../../lib/season';
import { findEvent } from '../../lib/events';
import { fitTitle } from '../../lib/seo';
import { ogPath } from '../../lib/ogPaths';
import { jsonForScript } from '../../lib/jsonForScript';
import { isoCountry } from '../../lib/results';
import { countryFlag, layoutLabel, weekStartLabel } from '../../lib/format';
import { dropFixedSize, stripTrackBackground } from '../../lib/trackSvg';
import { defaultLayout, specsFor, type SpecLayout, type LapRecord, type Fia } from '../../lib/trackSpecs';
import { fastestRecords, osmEmbedUrl, osmLink, rollOfHonourForTrack, type TrackRecord } from '../../lib/trackExtras';

type Layout = SpecLayout & { label: string };
type Logistics = {
  nearest_airport: string;
  transport: string;
  accommodation_hub: string;
  travel_tip: string;
  affiliate_hooks: string[];
};
type Venue = {
  slug: string;
  name: string;
  city: string;
  country: string;
  continent: string;
  browserSvg: string;
  calendarSvgs: string[];
  layouts?: Layout[];
  /** Specs of a single-layout track. A track with `layouts` carries them on each layout (see lib/trackSpecs). */
  length?: number | null;
  turns?: number | null;
  direction?: string;
  type?: string;
  lapRecord?: LapRecord | null;
  fia?: Fia;
  website?: string;
  bio?: string;
  overview?: string;
  history?: string;
  notable_moments?: string;
  logistics?: Logistics;
  lat?: number;
  lng?: number;
  address?: string;
  opened?: number;
  capacity?: number;
  records?: TrackRecord[];
  photos?: Photo[];
};

type Photo = {
  file: string;
  url: string;
  image_url: string;
  license: string;
  author: string;
  caption: string;
};

export function getStaticPaths() {
  return (tracksRaw as Venue[]).map(v => ({ params: { slug: v.slug } }));
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const venue = (tracksRaw as Venue[]).find(v => v.slug === slug)!;

// ── Gather events from calendar ───────────────────────────────────────────────
// Single-driver series store `winner`; multi-driver series store `winners` (a crew).
type ResultEntry = { race_label?: string; winner?: string; winners?: string[]; team?: string; manufacturer?: string; country?: string; };
type CalEvent = {
  series: string; tag: string; title: string;
  week: string; layoutId: string | null;
  /** Canonical event page, e.g. "/events/2026/f1-monaco-gp". */
  path: string | null;
};
type CalResult = CalEvent & { entries: ResultEntry[]; };

const pastResults: CalResult[] = [];
const upcomingEvents: CalEvent[] = [];

for (const month of calendarData as any[]) {
  if (!showOnTrackPages(month)) continue;   // later seasons live on the main calendar only
  for (const week of month.weeks) {
    for (const ev of week.events) {
      if (!ev.track || !venue.calendarSvgs.includes(ev.track)) continue;
      let layoutId: string | null = null;
      if (venue.layouts) {
        const match = venue.layouts.find((l: Layout) => l.calendarSvgs.includes(ev.track));
        layoutId = match ? match.id : null;
      }
      const path = findEvent(monthYear(month), ev.series, ev.title, week.label)?.path ?? null;
      if (ev.results?.length) {
        const isDupe = pastResults.some(e => e.series === ev.series && e.title === ev.title && e.week === week.label);
        if (!isDupe) pastResults.push({ series: ev.series, tag: ev.tag, title: ev.title, week: week.label, layoutId, path, entries: ev.results });
      } else {
        const isDupe = upcomingEvents.some(e => e.series === ev.series && e.title === ev.title && e.week === week.label);
        if (!isDupe) upcomingEvents.push({ series: ev.series, tag: ev.tag, title: ev.title, week: week.label, layoutId, path });
      }
    }
  }
}

const allEvents = [...pastResults, ...upcomingEvents];
const activeSeries = [...new Set(allEvents.map(e => e.series))];

// ── Geo / map, records, roll of honour, photos ──────────────────────────────
// The map is an OpenStreetMap embed (no API key) centred on the track's lat/lng.
// Records are reduced to the outright time per category; the roll of honour
// scans every season in the calendar, not just the ones shown above.
const hasGeo = typeof venue.lat === 'number' && typeof venue.lng === 'number';
const mapEmbed = hasGeo ? osmEmbedUrl(venue.lat!, venue.lng!) : null;
const mapLink = hasGeo ? osmLink(venue.lat!, venue.lng!) : null;
const recordRows = fastestRecords(venue.records);
const RECORDS_SHOWN = 12;
const honour = rollOfHonourForTrack(venue);
const photos = venue.photos ?? [];


// ── SVG ───────────────────────────────────────────────────────────────────────
// The inline map is the page's main image: it gets a name, like the <img>
// versions of the same files ("{name} track layout").
const escAttr = (v: string) => v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
function cleanSvg(raw: string, label: string): string {
  return dropFixedSize(stripTrackBackground(raw))
    .replace(/<svg\b/, `<svg role="img" aria-label="${escAttr(label)}"`);
}

const rawSvg = readSvg(venue.browserSvg);
const svgContent = rawSvg ? cleanSvg(rawSvg, `${venue.name} track layout`) : null;

// For multi-layout tracks: inline each layout's SVG so we can panel-swap on hover
type LayoutWithSvg = Layout & { svgContent: string | null; };
const layoutSvgPanels: LayoutWithSvg[] = (venue.layouts ?? []).map(l => {
  const raw = readSvg(l.calendarSvgs[0]);
  return { ...l, svgContent: raw ? cleanSvg(raw, `${venue.name} track layout, ${l.label}`) : null };
});
const hasLayoutPanels = layoutSvgPanels.length > 1 && layoutSvgPanels.some(l => l.svgContent);

// ── Specs per layout ─────────────────────────────────────────────────────────
// Length, turns, lap record and FIA grade belong to a layout (Mexico City's
// Formula E loop is 2.63 km, its F1 circuit 4.304 km), so a multi-layout page
// renders one specs panel per layout and the layout buttons swap them. The page
// opens on the layout that draws the track's browserSvg. A single-layout track
// has one panel.
const openLayoutId = hasLayoutPanels ? (defaultLayout(venue)?.id ?? layoutSvgPanels[0].id) : null;
const specPanels = (hasLayoutPanels ? layoutSvgPanels : [null]).map(l => ({
  layoutId: l ? l.id : null,
  open: l ? l.id === openLayoutId : true,
  specs: specsFor(venue, l),
}));
const hasSpecs = specPanels.some(p => p.specs.length || p.specs.turns || p.specs.direction || p.specs.type
  || p.specs.lapRecord || p.specs.fia) || !!venue.website;


const continentLabel: Record<string, string> = {
  'europe': 'Europe', 'north-america': 'North America', 'asia': 'Asia',
  'middle-east': 'Middle East', 'south-america': 'South America', 'oceania': 'Oceania',
};

// ── SEO / structured data ─────────────────────────────────────────────────────
const seriesNameMap: Record<string, string> = Object.fromEntries(
  (seriesContentData as any[]).map((s: any) => [s.slug, s.name])
);

const champCount = activeSeries.length;
const pageTitle = fitTitle([
  `${venue.name} — ${DEFAULT_CALENDAR_YEAR} Race Schedule & Guide | DORD`,
  `${venue.name} — ${DEFAULT_CALENDAR_YEAR} Race Schedule | DORD`,
  `${venue.name} ${DEFAULT_CALENDAR_YEAR} Races | DORD`,
  `${venue.name} | DORD`,
]);
const pageDescription = champCount > 0
  ? `All ${DEFAULT_CALENDAR_YEAR} races at ${venue.name} — dates, series, and session times across ${champCount} championship${champCount !== 1 ? 's' : ''}. Updated weekly.`
  : `${venue.name} circuit guide — track map, specifications, and lap record. ${venue.city}, ${venue.country}.`;

// Each event page carries the full SportsEvent markup; the track page lists
// them rather than repeating it (and it used to claim free, in-stock tickets).
const eventListSchema = (() => {
  const items = [...pastResults, ...upcomingEvents].filter((ev: any) => ev.path);
  return items.length ? {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `${DEFAULT_CALENDAR_YEAR} events at ${venue.name}`,
    "numberOfItems": items.length,
    "itemListElement": items.map((ev: any, i: number) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": `${seriesNameMap[ev.series] ?? ev.series} — ${ev.title} ${DEFAULT_CALENDAR_YEAR}`,
      "url": `https://dord.racing${ev.path}`,
    })),
  } : null;
})();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`https://dord.racing/tracks/${slug}`}
  ogImage={ogPath(`tracks/${slug}`)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "SportsActivityLocation",
      "name": venue.name,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": venue.city,
        "addressCountry": isoCountry(venue.country),
      },
      "url": `https://dord.racing/tracks/${slug}`,
      ...((venue as any).website ? { "sameAs": (venue as any).website } : {}),
      ...(hasGeo
        ? { "geo": { "@type": "GeoCoordinates", "latitude": venue.lat, "longitude": venue.lng } }
        : {}),
    })} />
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dord.racing" },
        { "@type": "ListItem", "position": 2, "name": "Track Browser", "item": "https://dord.racing/tracks" },
        { "@type": "ListItem", "position": 3, "name": venue.name, "item": `https://dord.racing/tracks/${slug}` },
      ],
    })} />
    {eventListSchema && (
      <script type="application/ld+json" set:html={jsonForScript(eventListSchema)} />
    )}
  </Fragment>
  <header>
    <div class="header--left">
      <h1>{venue.name} — {DEFAULT_CALENDAR_YEAR} Race Calendar</h1>
      <div class="meta">{venue.city} · {venue.country} · {continentLabel[venue.continent] ?? venue.continent}</div>
      <Nav activePage="tracks" />
    </div>
  </header>

  <main id="main-content" class="track-page">

    <a href={`${base}/tracks`} class="back-link">← All Circuits</a>

    <div class="track-split">
    <div class="track-col-left">

    <!-- Hero -->
    <div class="track-hero theme-dark" style={`background-image: url('${base}/assets/track-bgs/${'bg' in venue && (venue as any).bg ? (venue as any).bg : 'default.webp'}')`}>
      <div class="track-hero-svg">
        {hasLayoutPanels ? (
          layoutSvgPanels.map(l => (
            <div class="layout-panel" data-layout-id={l.id} style={l.id === openLayoutId ? '' : 'display:none'}>
              {l.svgContent
                ? <Fragment set:html={l.svgContent} />
                : <div class="hero-placeholder">{l.label}</div>
              }
            </div>
          ))
        ) : (
          svgContent
            ? <Fragment set:html={svgContent} />
            : <div class="hero-placeholder">{venue.name}</div>
        )}
      </div>
      {hasLayoutPanels && (
        <div class="layout-btns">
          {layoutSvgPanels.map(l => (
            <button
              type="button"
              class={`layout-btn${l.id === openLayoutId ? ' active' : ''}`}
              data-layout-target={l.id}
              aria-pressed={l.id === openLayoutId ? 'true' : 'false'}
            >
              {layoutLabel(l.id)}
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Name + Info -->
    <div class="track-meta-row">
      <div class="track-meta-left">
        <h2 class="track-name">{venue.name}</h2>
        <div class="track-location">{venue.city} · {venue.country}</div>
        {activeSeries.length > 0 && (
          <div class="track-series-list">
            {activeSeries.map(s => (
              <a href={`${base}/series/${s}`} class={`tag t-${s}`}>
                {allEvents.find(e => e.series === s)?.tag}
              </a>
            ))}
          </div>
        )}
      </div>
      {venue.bio && (
        <p class="track-bio">{venue.bio}</p>
      )}
    </div>

    <!-- Circuit specs: two islands per layout, vertical dividers only -->
    {hasSpecs && (
      <section class="track-specs" aria-labelledby="specs-title">
        <div class="specs-head">
          <h2 class="specs-title" id="specs-title">Layout</h2>
          {hasLayoutPanels && (
            <div class="specs-switch" role="group" aria-label="Choose a layout">
              {layoutSvgPanels.map(l => (
                <button
                  type="button"
                  class={`specs-chip${l.id === openLayoutId ? ' active' : ''}`}
                  data-layout-target={l.id}
                  aria-pressed={l.id === openLayoutId ? 'true' : 'false'}
                >
                  {layoutLabel(l.id)}
                </button>
              ))}
            </div>
          )}
          {specPanels.map(p => {
            const series = hasLayoutPanels
              ? [...new Set(allEvents.filter(e => e.layoutId === p.layoutId).map(e => e.series))]
              : activeSeries;
            return series.length > 0 && (
              <div class="specs-series" data-spec-layout={p.layoutId ?? undefined} hidden={!p.open}>
                {series.map(s => (
                  <a href={`${base}/series/${s}`} class={`tag t-${s}`}>{allEvents.find(e => e.series === s)?.tag}</a>
                ))}
              </div>
            );
          })}
        </div>

        {specPanels.map(p => {
          const sp = p.specs;
          const hasFacts = sp.length || sp.turns || sp.direction || sp.type || sp.fia?.pole;
          const hasRecord = sp.lapRecord || sp.fia || venue.website;
          return (
            <div class="specs-panel" data-spec-layout={p.layoutId ?? undefined} hidden={!p.open}>
              {hasFacts && (
                <div class="spec-island">
                  <div class="spec-cells">
                    {sp.length && (
                      <div class="spec-cell">
                        <div class="spec-label">Length</div>
                        <div class="spec-value">{sp.length} km</div>
                      </div>
                    )}
                    {sp.turns && (
                      <div class="spec-cell">
                        <div class="spec-label">Turns</div>
                        <div class="spec-value">{sp.turns}</div>
                      </div>
                    )}
                    {sp.direction && (
                      <div class="spec-cell spec-cell--wide">
                        <div class="spec-label">Direction</div>
                        <div class="spec-value">{sp.direction}</div>
                      </div>
                    )}
                    {sp.type && (
                      <div class="spec-cell">
                        <div class="spec-label">Type</div>
                        <div class="spec-value">{sp.type}</div>
                      </div>
                    )}
                    {sp.fia?.pole && (
                      <div class="spec-cell">
                        <div class="spec-label">Pole side</div>
                        <div class="spec-value spec-value--pole">
                          <svg class="pole-icon" viewBox="0 0 28 20" width="28" height="20" aria-hidden="true" focusable="false">
                            <path class="pole-edge" d="M4 1V19M24 1V19" />
                            <path class="pole-centre" d="M14 1V19" />
                            <rect class="pole-slot" x={sp.fia.pole === 'Left' ? 6.5 : 15.5} y="5" width="6" height="10" rx="1" />
                          </svg>
                          {sp.fia.pole}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}
              {hasRecord && (
                <div class="spec-island">
                  <div class="spec-cells">
                    {sp.lapRecord && (
                      <div class="spec-cell spec-cell--lap">
                        <div class="spec-lap-line">
                          <span class="spec-label">Lap record</span>
                          <span class="spec-value spec-value--lap">{sp.lapRecord.time}</span>
                        </div>
                        <div class="spec-sub">{[sp.lapRecord.driver, sp.lapRecord.series, sp.lapRecord.year].filter(Boolean).join(' · ')}</div>
                      </div>
                    )}
                    {sp.fia && (
                      <div class="spec-cell">
                        <div class="spec-label">FIA grade</div>
                        <div class="spec-value"><span class="fia-badge">{sp.fia.grade}</span></div>
                      </div>
                    )}
                    {venue.website && (
                      <div class="spec-cell spec-cell--link">
                        <a href={venue.website} target="_blank" rel="noopener noreferrer" class="spec-website">
                          <img src={`${base}/assets/website-icon.svg`} alt="" width="14" height="14" />
                          Official Site
                          <span class="spec-website-arrow" aria-hidden="true">↗</span>
                        </a>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </section>
    )}

    <!-- Layouts -->
    {venue.layouts && (
      <div class="track-layouts-section">
        <div class="section-label">LAYOUTS IN USE</div>
        <div class="layouts-list">
          {venue.layouts.map(l => (
            <div class="layout-row">
              <span class="layout-id">{layoutLabel(l.id)}</span>
              <span class="layout-label">{l.label}</span>
              <div class="layout-series">
                {allEvents
                  .filter(e => e.layoutId === l.id)
                  .map(e => (
                    <a href={`${base}/series/${e.series}`} class={`tag t-${e.series}`}>{e.tag}</a>
                  ))
                }
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Circuit records: outright time per category, fastest first -->
    {recordRows.length > 0 && (
      <div class="track-records-section">
        <div class="section-label">CIRCUIT RECORDS</div>
        <div class="records-list">
          {recordRows.slice(0, RECORDS_SHOWN).map(r => (
            <div class="record-row">
              <span class="record-series">{r.label}</span>
              <span class="record-time">{r.time}</span>
              <span class="record-driver">{r.driver}</span>
              <span class="record-meta">{[r.car, r.year, r.event].filter(Boolean).join(' · ')}</span>
            </div>
          ))}
        </div>
        {recordRows.length > RECORDS_SHOWN && (
          <details class="records-more">
            <summary>All {recordRows.length} record categories</summary>
            <div class="records-list">
              {recordRows.slice(RECORDS_SHOWN).map(r => (
                <div class="record-row">
                  <span class="record-series">{r.label}</span>
                  <span class="record-time">{r.time}</span>
                  <span class="record-driver">{r.driver}</span>
                  <span class="record-meta">{[r.car, r.year, r.event].filter(Boolean).join(' · ')}</span>
                </div>
              ))}
            </div>
          </details>
        )}
      </div>
    )}

    <!-- Results -->
    {pastResults.length > 0 && (
      <div class="track-events-section">
        <div class="section-label">RESULTS</div>
        <div class="results-list">
          {pastResults.map(ev => (
            <div class="result-block" data-layout-id={ev.layoutId ?? undefined}>
              <div class="result-header">
                <span class="ev-date">{weekStartLabel(ev.week)}</span>
                <a href={`${base}/series/${ev.series}`} class={`tag t-${ev.series}`}>{ev.tag}</a>
                {ev.path
                  ? <a href={`${base}${ev.path}`} class="ev-title ev-title--link">{ev.title}</a>
                  : <span class="ev-title">{ev.title}</span>}
              </div>
              <div class="result-entries">
                {ev.entries.map((r: ResultEntry) => (
                  <div class="result-entry">
                    <span class="res-label">{r.race_label}</span>
                    <span class="res-winner">{r.winners?.length ? r.winners.join(' · ') : r.winner}</span>
                    <span class="res-team">{r.team}</span>
                    <span class="res-flag">{countryFlag(r.country)}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Upcoming events -->
    {(upcomingEvents.length > 0 || pastResults.length === 0) && (
      <div class="track-events-section">
        <div class="section-label">{pastResults.length > 0 ? 'UPCOMING' : `${DEFAULT_CALENDAR_YEAR} EVENTS`}</div>
        {upcomingEvents.length > 0 ? (
          <div class="events-list">
            {upcomingEvents.map(ev => (
              <div class="ev-row" data-layout-id={ev.layoutId ?? undefined}>
                <span class="ev-date">{weekStartLabel(ev.week)}</span>
                <a href={`${base}/series/${ev.series}`} class={`tag t-${ev.series}`}>{ev.tag}</a>
                {ev.path
                  ? <a href={`${base}${ev.path}`} class="ev-title ev-title--link">{ev.title}</a>
                  : <span class="ev-title">{ev.title}</span>}
              </div>
            ))}
          </div>
        ) : (
          <p class="no-events">No events at this venue in {DEFAULT_CALENDAR_YEAR}.</p>
        )}
      </div>
    )}

    <!-- Roll of honour: winners at this venue across every season in the calendar -->
    {honour.length > 0 && (
      <div class="track-honour-section">
        <div class="section-label">ROLL OF HONOUR · WINNERS AT {venue.name.toUpperCase()}</div>
        {honour.map(g => (
          <div class="honour-group">
            <div class="honour-head">
              <a href={`${base}/series/${g.series}`} class={`tag t-${g.series}`}>{g.tag}</a>
              <span class="honour-series-name">{g.seriesName}</span>
            </div>
            <div class="honour-rows">
              {g.rows.map(r => (
                <div class="honour-row">
                  <span class="honour-year">{r.year}</span>
                  {r.path
                    ? <a href={`${base}${r.path}`} class="honour-title honour-title--link">{r.title}</a>
                    : <span class="honour-title">{r.title}</span>}
                  {r.raceLabel && <span class="honour-race">{r.raceLabel}</span>}
                  {r.winner && (
                    <span class="honour-winner">
                      {r.winner}
                      {r.country && <span class="res-flag" aria-hidden="true"> {countryFlag(r.country)}</span>}
                    </span>
                  )}
                  {r.team && <span class="honour-team">{r.team}</span>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Photos from Wikimedia Commons, each with its author and licence -->
    {photos.length > 0 && (
      <div class="track-photos-section">
        <div class="section-label">PHOTOS</div>
        <div class="photos-grid">
          {photos.map(p => (
            <figure class="photo-card">
              <a href={p.url} target="_blank" rel="noopener noreferrer">
                <img src={p.image_url} alt={p.caption} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
              </a>
              <figcaption>
                <span class="photo-caption">{p.caption}</span>
                <span class="photo-credit">
                  © <a href={p.url} target="_blank" rel="noopener noreferrer">{p.author}</a> · {p.license}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="photos-note">Photos via Wikimedia Commons — every image links to its file page with the full licence.</p>
      </div>
    )}

    </div><!-- /track-col-left -->

    <div class="track-col-right">
      {(hasGeo || venue.address) && (
        <section class="track-loc" aria-labelledby="track-loc-h">
          <div class="section-label" id="track-loc-h">LOCATION</div>
          {mapEmbed && (
            <div class="track-map">
              <iframe
                src={mapEmbed}
                title={`Map showing ${venue.name}, ${venue.city}`}
                loading="lazy"
                referrerpolicy="no-referrer"
              ></iframe>
            </div>
          )}
          <dl class="track-loc-rows">
            {hasGeo && (
              <div class="track-loc-row">
                <dt>COORDINATES</dt>
                <dd class="track-loc-mono">{venue.lat}, {venue.lng}</dd>
              </div>
            )}
            {venue.address && (
              <div class="track-loc-row">
                <dt>ADDRESS</dt>
                <dd>{venue.address}</dd>
              </div>
            )}
            {venue.opened && (
              <div class="track-loc-row">
                <dt>OPENED</dt>
                <dd class="track-loc-mono">{venue.opened}</dd>
              </div>
            )}
            {venue.capacity && (
              <div class="track-loc-row">
                <dt>CAPACITY</dt>
                <dd class="track-loc-mono">{Number(venue.capacity).toLocaleString('en-GB')}</dd>
              </div>
            )}
            <div class="track-loc-row">
              <dt>REGION</dt>
              <dd>{continentLabel[venue.continent] ?? venue.continent} · {venue.country}</dd>
            </div>
          </dl>
          {mapLink && (
            <a class="track-loc-link" href={mapLink} target="_blank" rel="noopener noreferrer">
              View larger map on OpenStreetMap <span aria-hidden="true">↗</span>
            </a>
          )}
        </section>
      )}
      {(venue.overview || venue.history || venue.notable_moments) && (
        <div class="track-content-sections">
          {venue.overview && (
            <div class="track-content-block">
              <div class="section-label">OVERVIEW</div>
              <p class="track-content-text">{venue.overview}</p>
            </div>
          )}
          {venue.history && (
            <div class="track-content-block">

          )}
        </div>
      )}
      {venue.logistics && <GettingThereCard logistics={venue.logistics} />}
      <TripPlannerCard
        city={venue.city}
        slug={slug}
        hotelQuery={accommodationQuery(venue.logistics?.accommodation_hub, venue.city)}
      />
    </div><!-- /track-col-right -->
    </div><!-- /track-split -->

    <a href={`${base}/tracks`} class="back-link back-link--bottom">← All Circuits</a>

  </main>

  <Footer />
</BaseLayout>

<script>
  // Layout switching. The buttons over the map and the chips in the Layout header
  // drive the same state: the map, the specs panel (length, turns, lap record, FIA
  // grade) and the series tags all follow the selected layout.
  const panels = document.querySelectorAll<HTMLElement>('.layout-panel');
  const btns   = document.querySelectorAll<HTMLButtonElement>('[data-layout-target]');

  if (panels.length > 1 && btns.length > 0) {
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.layoutTarget!;
        panels.forEach(p => { p.style.display = p.dataset.layoutId === target ? '' : 'none'; });
        document.querySelectorAll<HTMLElement>('[data-spec-layout]').forEach(el => {
          el.hidden = el.dataset.specLayout !== target;
        });
        btns.forEach(b => {
          b.classList.toggle('active', b.dataset.layoutTarget === target);
          b.setAttribute('aria-pressed', b.dataset.layoutTarget === target ? 'true' : 'false');
        });
      });
    });
  }
</script>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CountryDialog from '../components/CountryDialog.astro';

import calendarData from '../../data/calendar.json';
import tracksData from '../../data/tracks.json';
import seriesContent from '../../data/seriesContent.json';
import { jsonForScript } from '../lib/jsonForScript';
import { trackSlugForSvg } from '../lib/events';
import { DEFAULT_CALENDAR_YEAR, monthYear } from '../lib/season';
import { activeWeekend, weekendSections } from '../scripts/watchWeekend.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build track slug → name lookup
const trackBySlug = new Map<string, any>();
for (const t of tracksData as any[]) trackBySlug.set(t.slug, t);


// Build howToWatch lookup
const htwBySlug = new Map<string, any>();
for (const s of seriesContent as any[]) {
  if ((s as any).howToWatch) htwBySlug.set(s.slug, (s as any).howToWatch);
}

// Embed current + next week's calendar events (two weeks max)
// Each event carries its own date (the same ISO timestamp series.json is
// generated from), so the client needs no second data set to time it.
// Only events from a week before the build onwards are embedded: the page
// shows the current or next weekend, and builds run at least weekly.
interface WatchEvent {
  series: string;
  /** ISO timestamp of the main race, Paris offset. */
  date: string;
  tag: string;
  title: string;
  timeHtml: string;
  weekLabel: string;
  year: number;
  trackName: string | null;
  trackSlug: string | null;
}

const EMBED_FROM = Date.now() - 7 * 864e5;
const watchEvents: WatchEvent[] = [];
for (const month of calendarData as any[]) {
  const year: number = monthYear(month);
  for (const week of month.weeks) {
    for (const ev of week.events) {
      if (!ev.date || Date.parse(ev.date) < EMBED_FROM) continue;
      const slug = trackSlugForSvg(ev.track);
      const track = slug ? trackBySlug.get(slug) ?? null : null;
      watchEvents.push({
        series: ev.series,
        date: ev.date,
        tag: ev.tag,
        title: ev.title,
        timeHtml: ev.time ?? '',
        weekLabel: week.label,
        year,
        trackName: track?.name ?? null,
        trackSlug: track ? slug : null,
      });
    }
  }
}

// The weekend as it stands at build time, rendered into the page so a crawler
// or a visitor without JavaScript gets the schedule (Paris times, no
// broadcasters: those follow the visitor's country). The script replaces it on
// load with the weekend as it stands then. Daily builds keep it current.
const buildWeekend = activeWeekend(watchEvents.map(e => ({ ...e, ts: Date.parse(e.date) })), new Date());
const buildSections = buildWeekend.isEmpty ? [] : weekendSections(buildWeekend.events);
const shortDay = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'short' });
const buildSubtitle = buildWeekend.isEmpty ? 'Loading…'
  : `${shortDay(buildWeekend.friStr!)} – ${shortDay(buildWeekend.sunStr!)} · PARIS TIME (CET/CEST)`;

// howToWatch is a property of the SERIES, not the event. Inlining it on every
// event repeated the same 14 objects 246 times and made this page a 261 KB
// download. Emit each once and let the client look it up by series slug.
const howToWatchBySeries: Record<string, any> = Object.fromEntries(
  [...new Set(watchEvents.map(e => e.series))]
    .filter(slug => htwBySlug.has(slug))
    .map(slug => [slug, htwBySlug.get(slug)])
);
---

<BaseLayout
  title={`Watch This Weekend — ${DEFAULT_CALENDAR_YEAR} Motorsport Schedule | DORD Racing`}
  description="Every motorsport session on TV this weekend. Times in your local timezone, broadcaster info for your country."
  canonicalUrl="https://dord.racing/watch"
  ogImage="https://dord.racing/assets/og/og-watch.webp"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dord.racing" },
        { "@type": "ListItem", "position": 2, "name": "Watch", "item": "https://dord.racing/watch" }
      ]
    })} />
  </Fragment>

  <header>
    <div class="header--left">
      <h1>Watch This<br>Weekend</h1>
      <p class="watch-subtitle meta" id="watch-subtitle">{buildSubtitle}</p>
      <Nav activePage="watch" />
    </div>
  </header>

  <main id="main-content" class="main-section main-section--content watch-main">

    <!-- Event data embedded at build time; client script reads it -->
    <script
      type="application/json"
      id="watch-events-data"
      set:html={jsonForScript(watchEvents)}
    ></script>
    <!-- Broadcasters, one entry per series rather than per event -->
    <script
      type="application/json"
      id="watch-htw-data"
      set:html={jsonForScript(howToWatchBySeries)}
    ></script>

    <div id="watch-loading" class="watch-loading" hidden={!buildWeekend.isEmpty}>Loading schedule…</div>

    <!-- Which country's broadcasters are showing, and how to change it (filled by JS) -->
    <div id="watch-country-bar" class="watch-country-bar" hidden>
      <p id="watch-country-text" class="watch-country-text" aria-live="polite"></p>
      <button type="button" id="watch-country-change" class="watch-country-change"></button>
    </div>

    <!-- Day sections: the build-time weekend below, replaced by the script on load -->
    <div id="watch-content" hidden={buildWeekend.isEmpty}>
      {buildSections.map(sec => (
        <section class="watch-day-section">
          <h2 class="watch-day-heading">{sec.heading}</h2>
          <div class="watch-rows">
            {sec.events.map((ev: WatchEvent) => (
              <div class="watch-row" data-series={ev.series}>
                <a href={`${base}/series/${ev.series}`} class={`tag t-${ev.series} watch-tag`}>{ev.tag}</a>
                <div class="watch-row-body">
                  <span class="watch-title">{ev.title}</span>
                  {ev.trackSlug
                    ? <a href={`${base}/tracks/${ev.trackSlug}`} class="watch-track">{ev.trackName}</a>
                    : ev.trackName && <span class="watch-track">{ev.trackName}</span>}
                  <span class="watch-times" set:html={ev.timeHtml} />
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="watch-empty" class="watch-empty" hidden>
      <p class="watch-empty-msg" id="watch-empty-msg">No racing this weekend.</p>
      <p class="watch-empty-next" id="watch-empty-next"></p>
    </div>

  </main>
  <Footer />

  <CountryDialog />
</BaseLayout>

<script type="module">
import {
  SOURCE_TIMEZONE, USER_TIMEZONE, TZ_IS_OVERRIDE,
  NEEDS_TZ_CONVERSION, convertTimeStr
} from '../scripts/tz.js';
import {
  CHANGE_EVENT, getChoice, pickBroadcasters, regionLabel,
  openCountryDialog, initCountryDialog
} from '../scripts/country.js';
import { activeWeekend, weekendSections } from '../scripts/watchWeekend.js';

// ── Data ──────────────────────────────────────────────────────────────────────
const rawEl = document.getElementById('watch-events-data');
if (!rawEl) throw new Error('watch-events-data missing');
const ALL_EVENTS = JSON.parse(rawEl.textContent);

// Broadcasters keyed by series slug — see howToWatchBySeries in the frontmatter.
const htwEl = document.getElementById('watch-htw-data');
const HTW = htwEl ? JSON.parse(htwEl.textContent) : {};

// ── Timestamps (each embedded event carries its own date) ─────────────────────
const eventWithTs = ALL_EVENTS.map(ev => {
  const ts = Date.parse(ev.date);
  return { ...ev, ts: Number.isNaN(ts) ? null : ts };
});

// ── Find active weekend (src/scripts/watchWeekend.js, shared with the build) ──
const getActiveWeekendEvents = () => activeWeekend(eventWithTs, new Date());

// ── Next upcoming event (for empty state) ─────────────────────────────────────
function getNextEvent() {
  const now = Date.now();
  return eventWithTs.filter(ev => ev.ts !== null && ev.ts > now)
    .sort((a, b) => a.ts - b.ts)[0] ?? null;
}

// ── Broadcaster pills ─────────────────────────────────────────────────────────
// Which country's list to show is the visitor's choice (popup, remembered on
// this device), not a guess from the browser language. See scripts/country.js.
function renderPills(howToWatch) {
  const { list: broadcasters, scope } = pickBroadcasters(howToWatch);
  if (!broadcasters.length) return '';
  const pills = broadcasters.map(b => {
    const badge = b.type === 'free'
      ? '<span class="htw-badge htw-badge--free">FREE</span>'
      : b.type === 'streaming'
      ? '<span class="htw-badge htw-badge--stream">STREAM</span>'
      : '';
    return `<a href="${b.url}" target="_blank" rel="noopener noreferrer" class="htw-pill" aria-label="${b.name} — watch ${b.type ?? ''}">${b.name}${badge}</a>`;
  }).join('');
  // A country we list no broadcaster for (or a series that has none there)
  // shows the series' own worldwide option; say so rather than imply it is local.
  const note = scope === 'worldwide' && getChoice().code !== 'global'
    ? '<span class="htw-note watch-fallback">Worldwide option</span>'
    : '';
  return `<div class="htw-pills watch-pills">${pills}${note}</div>`;
}

// ── Row HTML builder ──────────────────────────────────────────────────────────
function renderEventRow(ev) {
  const base = document.querySelector('meta[name="astro-base"]')?.content ?? '';
  const timeConverted = convertTimeStr(ev.timeHtml, ev.weekLabel, ev.year, ev.date);
  const trackLink = ev.trackSlug
    ? `<a href="${base}/tracks/${ev.trackSlug}" class="watch-track">${ev.trackName}</a>`
    : (ev.trackName ? `<span class="watch-track">${ev.trackName}</span>` : '');
  const pills = renderPills(HTW[ev.series] ?? null);
  return `<div class="watch-row" data-series="${ev.series}">
    <a href="${base}/series/${ev.series}" class="tag t-${ev.series} watch-tag">${ev.tag}</a>
    <div class="watch-row-body">
      <span class="watch-title">${ev.title}</span>
      ${trackLink}
      <span class="watch-times">${timeConverted}</span>
      ${pills}
    </div>
  </div>`;
}

// ── Render ─────────────────────────────────────────────────────────────────────
const loadingEl  = document.getElementById('watch-loading');
const contentEl  = document.getElementById('watch-content');
const emptyEl    = document.getElementById('watch-empty');
const subtitleEl = document.getElementById('watch-subtitle');

const { events, friStr, sunStr, isEmpty } = getActiveWeekendEvents();
if (loadingEl) loadingEl.hidden = true;

if (isEmpty) {
  contentEl.hidden = true;   // the build-time schedule, if the weekend has moved on
  emptyEl.hidden = false;
  const next = getNextEvent();
  const msgEl  = document.getElementById('watch-empty-msg');
  const nextEl = document.getElementById('watch-empty-next');
  if (msgEl) msgEl.textContent = 'No racing this weekend.';
  if (nextEl && next) {
    const dateStr = new Date(next.ts).toLocaleDateString('en-GB', {
      timeZone: USER_TIMEZONE, weekday: 'short', day: 'numeric', month: 'short'
    });
    nextEl.textContent = `Next up: ${next.title} — ${dateStr}`;
  }
} else {
  contentEl.hidden = false;

  function section(heading, evList) {
    return `<section class="watch-day-section">
      <h2 class="watch-day-heading">${heading}</h2>
      <div class="watch-rows">${evList.map(renderEventRow).join('')}</div>
    </section>`;
  }

  const html = weekendSections(events).map(s => section(s.heading, s.events)).join('');
  contentEl.innerHTML = html;

  // Update subtitle
  if (subtitleEl && friStr) {
    const fStr = new Date(friStr + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
    const sStr = new Date(sunStr + 'T12:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
    const tzNote = TZ_IS_OVERRIDE
      ? ` · TIMES IN: ${USER_TIMEZONE.replace(/_/g, ' ').toUpperCase()} (MANUAL)`
      : NEEDS_TZ_CONVERSION ? ` · TIMES IN YOUR TIMEZONE` : ` · PARIS TIME (CET/CEST)`;
    subtitleEl.textContent = `${fStr} – ${sStr}${tzNote}`;
  }
}

// ── Country: status bar + popup ───────────────────────────────────────────────
// Broadcasters follow the visitor's chosen country (scripts/country.js). First
// visit with a schedule on screen: ask. Esc / clicking outside is "not now" and
// saves nothing, so we ask again next time; only an explicit answer is stored.
const barEl     = document.getElementById('watch-country-bar');
const barTextEl = document.getElementById('watch-country-text');
const barBtn    = document.getElementById('watch-country-change');

function renderCountryBar() {
  if (!barEl || !barTextEl || !barBtn || isEmpty) return;
  const { code, state } = getChoice();
  if (state !== 'chosen') {
    barTextEl.textContent = "Showing the USA's options by default. They may not be available in your region.";
    barBtn.textContent = 'Set your country';
  } else if (code === 'global') {
    barTextEl.textContent = 'Showing worldwide streaming options.';
    barBtn.textContent = 'Change country';
  } else if (!Object.values(HTW).some(h => h[code]?.length)) {
    barTextEl.textContent = `We don't list local broadcasters for ${regionLabel(code)} yet. Showing worldwide options.`;
    barBtn.textContent = 'Change country';
  } else {
    barTextEl.textContent = `Showing broadcasters for ${regionLabel(code)}.`;
    barBtn.textContent = 'Change country';
  }
  barEl.hidden = false;
}

// Swap only the broadcaster pills; the schedule above them stays put.
function refreshPills() {
  for (const row of document.querySelectorAll('.watch-row')) {
    row.querySelector('.watch-pills')?.remove();
    const html = renderPills(HTW[row.dataset.series] ?? null);
    if (html) row.querySelector('.watch-row-body')?.insertAdjacentHTML('beforeend', html);
  }
  renderCountryBar();
}

barBtn?.addEventListener('click', openCountryDialog);
window.addEventListener(CHANGE_EVENT, refreshPills);
initCountryDialog();
renderCountryBar();
if (!isEmpty && getChoice().state === 'undecided') openCountryDialog();
</script>

<style is:global>
.watch-main {
  padding-top: 0;
}

.watch-subtitle {
  margin-top: 4px;
  font-size: var(--fs-sm);
}

.watch-loading {
  color: var(--text-dim);
  font-family: var(--font-mono);
  font-size: var(--fs-md);
  padding: 32px 0;
  /* Reserve the schedule's space while it loads, so the footer is below the
     fold and never shifts if the fetch fallback (or a slow device) renders late. */
  min-height: 80svh;
}

.watch-country-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px 14px;
  margin: 0 0 24px;
  padding: 10px 14px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
}

.watch-country-bar[hidden] { display: none; }

.watch-country-text {
  flex: 1 1 260px;
  margin: 0;
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  color: var(--text-muted);
}

.watch-country-change {
  padding: 0;
  border: 0;
  background: none;
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--text-soft);
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}

.watch-country-change:hover { color: var(--text-strong); }

.watch-country-change:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 3px;
}

.watch-empty {
  padding: 48px 0 32px;
  text-align: center;
}

.watch-empty-msg {
  font-family: var(--font-mono);
  font-size: var(--fs-xl);
  color: var(--text-muted);
  margin-bottom: 8px;
}

.watch-empty-next {
  font-family: var(--font-mono);
  font-size: var(--fs-md);
  color: var(--text-dim);
}

.watch-day-section {
  margin-bottom: 40px;
}

.watch-day-heading {
  font-family: var(--font-mono);
  font-size: var(--fs-sm);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-dim);
  border-bottom: 1px solid var(--overlay-soft-3);
  padding-bottom: 8px;
  margin: 0 0 16px;
}

.watch-rows {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.watch-row {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: var(--card-bg);
  border: 1px solid var(--border);
  padding: 12px 14px;
  border-radius: var(--radius-xl);
}

.watch-tag {
  flex-shrink: 0;
  text-decoration: none;
}

.watch-row-body {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.watch-title {
  font-family: var(--font-body);
  font-size: var(--fs-lg);
  color: var(--text-heading);
  font-weight: 700;
  letter-spacing: 0.03em;
}

.watch-track {
  font-family: var(--font-mono);
  font-size: var(--fs-xs-2);
  color: var(--text-dim);
  text-decoration: none;
}

a.watch-track:hover {
  color: var(--text-muted);
}

.watch-times {
  font-family: var(--font-mono);
  font-size: var(--fs-sm-3);
  color: var(--text-muted);
  line-height: 1.5;
}

.watch-pills {
  margin-top: 4px;
}

@media (max-width: 600px) {
  .watch-row { flex-direction: column; gap: 8px; }
}
</style>

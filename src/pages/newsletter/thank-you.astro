---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
  title="You're on the grid — From The Pit Wall"
  description="Thanks for subscribing to From The Pit Wall, the weekly motorsport briefing from DORD Racing."
  canonicalUrl="https://dord.racing/newsletter/thank-you"
>

  <main id="main-content" class="ty-page">

    <section class="ty-hero" aria-labelledby="ty-title">
      <div class="ty-inner">

        <div class="ty-kicker">FROM THE PIT WALL</div>

        <h1 class="ty-headline" id="ty-title">You're on<br>the grid.</h1>

        <p class="ty-body">
          First briefing lands before the next race weekend.<br>
          25 series, no filler, every Monday.
        </p>

        <a href="/" class="ty-cta">← Back to the calendar</a>

      </div>
    </section>

    <Footer />

  </main>

</BaseLayout>

<style>
  .ty-page {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .ty-hero {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--surface-sunken-2) url(/assets/mailing-banner-mobile.webp) center center / cover no-repeat;
    overflow: hidden;
    min-height: 100svh;
  }

  .ty-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
    pointer-events: none;
  }

  .ty-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    padding: 100px 24px 72px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ty-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs-5);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--text-dim-3);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .ty-headline {
    font-family: var(--font-display);
    font-size: var(--fs-display-2);
    font-weight: 900;
    color: var(--text-soft);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0 0 28px;
  }

  .ty-body {
    font-family: var(--font-mono);
    font-size: var(--fs-sm-2);
    color: var(--text-meta-4);
    letter-spacing: 0.02em;
    line-height: 1.8;
    margin: 0 0 40px;
    max-width: 46ch;
  }

  .ty-cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-soft);
    text-decoration: none;
    border: 1px solid var(--overlay-soft);
    padding: 12px 22px;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .ty-cta:hover {
    color: var(--text-strong);
    border-color: var(--accent);
    background: var(--card-bg-9);
  }

  .ty-cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (min-width: 769px) {
    .ty-hero {
      min-height: 92svh;
      background-image: url(/assets/mailing-banner-desktop.webp);
    }
    .ty-inner {
      max-width: 640px;
      padding: 120px 64px 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ty-cta { transition: none; }
  }
</style>

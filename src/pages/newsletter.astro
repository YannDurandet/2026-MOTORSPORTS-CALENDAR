---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="From The Pit Wall — Weekly Motorsport Briefing"
  description="A weekly briefing from The Department of Racing Drivers. What's racing, where it is, and why the next three days are going to be chaos. 26 series, no filler."
  canonicalUrl="https://dord.racing/newsletter"
  expect="nl-title"
>

  <main id="main-content" class="nl-page">

    <!-- ── Back link ────────────────────────────────────────────────── -->
    <a href={`${base}/`} class="nl-back">← dord.racing</a>

    <!-- ── Hero ─────────────────────────────────────────────────────── -->
    <section class="nl-hero theme-dark" aria-labelledby="nl-title">
      <div class="nl-inner">

        <div class="nl-kicker">FROM THE PIT WALL</div>
        <h1 class="nl-headline" id="nl-title">
          The weekly<br>racing briefing.
        </h1>
        <p class="nl-body">
          What's on, where it is, and why the next three days are going to be chaos.<br>
          26 series. Every weekend. No filler.
        </p>

        <!-- Form -->
        <NewsletterForm />

      </div>
    </section>

  </main>
  <Footer />

</BaseLayout>

<style>
  /* ── Page shell ─────────────────────────────────────────────────── */
  .nl-page {
    position: relative;        /* anchors .nl-back */
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  /* ── Back link ──────────────────────────────────────────────────── */
  /* Absolute, not fixed: a fixed link has no background, so it printed over
     the footer text whenever the page scrolled. It now scrolls away with the hero. */
  .nl-back {
    position: absolute;
    top: 20px;
    left: 24px;
    z-index: 10;
    font-family: var(--font-mono);
    font-size: var(--fs-3xs-6);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim-3);
    text-decoration: none;
    transition: color 0.15s;
  }
  .nl-back:hover { color: var(--text-soft); }

  /* ── Hero ───────────────────────────────────────────────────────── */
  .nl-hero {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--surface-sunken-2) url(/assets/mailing-banner-mobile.webp) center center / cover no-repeat;
    overflow: hidden;
    /* Full viewport on mobile */
    min-height: 100svh;
  }

  /* Scrim */
  .nl-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--scrim-hero);
    pointer-events: none;
  }

  /* ── Inner content ──────────────────────────────────────────────── */
  .nl-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 560px;
    padding: 100px 24px 72px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nl-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs-5);
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--text-dim-3);
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .nl-headline {
    font-family: var(--font-title);
    font-size: var(--fs-display-2);
    font-weight: 900;
    color: var(--text-soft);
    line-height: 0.95;
    letter-spacing: -0.01em;
    margin: 0 0 28px;
  }

  .nl-body {
    font-family: var(--font-mono);
    font-size: var(--fs-sm-2);
    color: var(--text-meta-4);
    letter-spacing: 0.02em;
    line-height: 1.8;
    margin: 0 0 36px;
    max-width: 46ch;
  }

  }

  /* ── Desktop ────────────────────────────────────────────────────── */
  @media (min-width: 769px) {
    .nl-hero {
      min-height: 92svh;
      background-image: url(/assets/mailing-banner-desktop.webp);
    }

    .nl-inner {
      max-width: 640px;
      padding: 120px 64px 80px;
    }
  }
</style>


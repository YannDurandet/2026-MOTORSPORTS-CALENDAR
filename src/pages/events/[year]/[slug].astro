---
/**
 * /events/{year}/{slug} — one page per race.
 *
 * The site previously had no per-event URL: every race lived only as a row
 * inside a track or series page, and all ~250 SportsEvent JSON-LD nodes
 * pointed at the same track URL. This page is the canonical home for an event,
 * and owns its structured data.
 *
 * It also carries the travel modules. "I want to go to this race" is an
 * event-level intent, not a circuit-level one, so GettingThereCard and
 * TripPlannerCard belong here at least as much as on /tracks/[slug].
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Banner from '../../../components/Banner.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import GettingThereCard from '../../../components/GettingThereCard.astro';
import TripPlannerCard from '../../../components/TripPlannerCard.astro';

import tracksData from '../../../../data/tracks.json';
import seriesContentData from '../../../../data/seriesContent.json';
import { ALL_EVENTS, eventsForTrack, eventsForSeries, plainTime, eventRange, type CalendarEvent, type RaceResult } from '../../../lib/events';
import { accommodationQuery, PARTNER_REL } from '../../../lib/affiliates';
import { parseSessions, mainRaceTime } from '../../../lib/sessions';
import { venueTimeZone, formatIn, zoneAbbr } from '../../../lib/timezones';
import { ticketLinks } from '../../../lib/tickets';
import { countryName } from '../../../lib/results';
import { venueFor } from '../../../lib/venues';
import { ogPath } from '../../../lib/ogPaths';
import { fitTitle } from '../../../lib/seo';
import { seriesShort } from '../../../lib/seriesShort';

export function getStaticPaths() {
  return ALL_EVENTS.map(ev => ({
    params: { year: String(ev.year), slug: ev.slug },
    props: { ev },
  }));
}

interface Props { ev: CalendarEvent }
const { ev } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://dord.racing/events/${ev.year}/${ev.slug}`;

const track = ev.trackSlug
  ? (tracksData as any[]).find(t => t.slug === ev.trackSlug)
  : null;

const venue = venueFor(ev);

const series = (seriesContentData as any[]).find(s => s.slug === ev.series);
const seriesName = series?.name ?? ev.tag;
const seriesWeb = series?.socials?.web as string | undefined;

// ── Dates ────────────────────────────────────────────────────────────────────
const when = new Date(ev.date);
const dateLong = when.toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
});
const isoDay = ev.date.slice(0, 10);
const isPast = !!ev.results?.length;

// ── Related ──────────────────────────────────────────────────────────────────
const alsoAtTrack = ev.trackSlug
  ? eventsForTrack(ev.trackSlug, ev.year).filter(e => e.slug !== ev.slug)
  : [];
const seriesRound = eventsForSeries(ev.series, ev.year);
const roundIndex = seriesRound.findIndex(e => e.slug === ev.slug);
const prevRound = roundIndex > 0 ? seriesRound[roundIndex - 1] : null;
const nextRound = roundIndex >= 0 && roundIndex < seriesRound.length - 1 ? seriesRound[roundIndex + 1] : null;

// ── Sessions & world clock ───────────────────────────────────────────────────
// Calendar times are Paris time. `ev.date` is the exact start of the one race
// it refers to; only when the time string names a single RACE at that same
// Paris time do we convert it to other zones, so a mismatch never publishes a
// wrong local time.
const sessions = parseSessions(ev.time);
const raceHHMM = mainRaceTime(sessions);
const raceKnown = !!raceHHMM && raceHHMM === formatIn(ev.date, 'Europe/Paris').time;
const timesTbc = /TBC/.test(ev.time);
const localTz = venueTimeZone(venue);
const ZONES: { label: string; tz: string; local?: boolean }[] = [
  ...(localTz && venue ? [{ label: `Circuit · ${venue.city}`, tz: localTz, local: true }] : []),
  { label: 'France · Paris', tz: 'Europe/Paris' },
  { label: 'UK · London', tz: 'Europe/London' },
  { label: 'US · New York', tz: 'America/New_York' },
  { label: 'US · Los Angeles', tz: 'America/Los_Angeles' },
  { label: 'Australia · Sydney', tz: 'Australia/Sydney' },
  { label: 'Japan · Tokyo', tz: 'Asia/Tokyo' },
];
const worldTimes = raceKnown
  ? ZONES.filter(z => z.local || z.tz !== localTz)
      .map(z => ({ ...z, ...formatIn(ev.date, z.tz), abbr: zoneAbbr(ev.date, z.tz) }))
  : [];
const localStart = worldTimes.find(z => z.local);
const utcStart = raceKnown ? formatIn(ev.date, 'UTC') : null;

// ── Overview prose ───────────────────────────────────────────────────────────
const longDay = (d: string) => new Date(`${d}T12:00:00Z`)
  .toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
const typeWord: Record<string, string> = { permanent: 'permanent road', street: 'street', oval: 'oval', mixed: 'road and oval' };
const firstResult = ev.results?.length === 1 ? ev.results[0] : null;
const overview: string[] = [];
overview.push(
  `The ${ev.title} is round ${roundIndex + 1} of ${seriesRound.length} in the ${ev.year} ${seriesName} season` +
  (venue ? `, at ${venue.name} in ${venue.city}, ${venue.country}` : '') +
  (ev.start && ev.end ? `, from ${longDay(ev.start)} to ${longDay(ev.end)}.` : ` (${eventRange(ev)}).`)
);
if (isPast && firstResult) {
  const w = firstResult.winners?.join(' and ') ?? firstResult.winner;
  const team = firstResult.team ?? firstResult.manufacturer;
  if (w) overview.push(`${w} won${team ? ` for ${team}` : ''}.`);
} else if (raceKnown && utcStart) {
  overview.push(
    `The race starts at ${raceHHMM} Paris time` +
    (localStart ? ` (${localStart.time} local, ${utcStart.time} UTC)` : ` (${utcStart.time} UTC)`) +
    ` on ${longDay(ev.date.slice(0, 10))}.`
  );
} else if (timesTbc) {
  overview.push(`Session times have not been published yet; they appear here as soon as ${seriesName} confirms them.`);
}
if (ev.hasSprint) overview.push('It is a Sprint weekend, with a shorter Sprint race on the Saturday alongside qualifying.');
if (track?.length) {
  const lr = track.lapRecord;
  overview.push(
    `${track.name} is a ${track.length} km ${typeWord[track.type] ?? ''} circuit` +
    (track.turns ? ` with ${track.turns} turns` : '') +
    (lr?.time ? `; the lap record is ${lr.time}, set by ${lr.driver}${lr.series ? ` (${lr.series}` : ''}${lr.year ? `, ${lr.year})` : lr.series ? ')' : ''}.` : '.')
  );
}

// ── How to watch ─────────────────────────────────────────────────────────────
const TYPE_LABEL: Record<string, string> = { free: 'Free-to-air', pay: 'Pay TV', streaming: 'Streaming' };
const watch = Object.entries((series?.howToWatch ?? {}) as Record<string, { name: string; type: string; url: string; note?: string }[]>)
  .map(([code, list]) => ({ code, country: code === 'global' ? 'Everywhere else' : countryName(code), list }))
  .sort((a, b) => (a.code === 'global' ? 1 : b.code === 'global' ? -1 : a.country.localeCompare(b.country)));

// ── Tickets ──────────────────────────────────────────────────────────────────
const tickets = isPast ? [] : ticketLinks({
  series: ev.series,
  title: ev.title,
  eventSlug: ev.slug,
  circuitName: track?.name,
  circuitUrl: track?.website,
});

function countryFlag(code?: string): string {
  if (!code || code.length !== 2) return '';
  return [...code.toUpperCase()].map(c => String.fromCodePoint(0x1F1E6 + c.charCodeAt(0) - 65)).join('');
}

function winnerOf(r: RaceResult): string {
  if (r.winners?.length) return r.winners.join(' · ');
  return r.winner ?? '';
}
function entrantOf(r: RaceResult): string {
  return r.team ?? r.manufacturer ?? '';
}

// ── SEO ──────────────────────────────────────────────────────────────────────
const where = venue ? `${venue.name}, ${venue.city}` : ev.title;
// Two same-series events with one title (Jeddah E-Prix ×2) carry the month in
// their slug; show it in the title and H1 so the pages aren't duplicates.
const monthTag = /-(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)$/.test(ev.slug)
  ? ` (${ev.slug.slice(-3).replace(/^./, c => c.toUpperCase())})` : '';
const short = seriesShort(ev.series, seriesName);
const name = `${ev.title}${monthTag} ${ev.year}`;
// Shared rounds (GTWCA + IGTC at Indianapolis) and generic titles ("Rd 4: Spa")
// exist in more than one series; name the series in the H1 there.
const sharedTitle = ALL_EVENTS.some(o => o.year === ev.year && o.title === ev.title && o.series !== ev.series);
const pageTitle = fitTitle([
  `${name} — ${short} Race Times & Circuit | DORD`,
  `${name} — ${short} Times & Circuit | DORD`,
  `${name} — ${short} Race Times | DORD`,
  `${name} — ${short} | DORD`,
  `${name} | DORD`,
  name,
]);
const pageDescription = isPast
  ? `${seriesName} ${ev.title} ${ev.year} at ${where} — full result, session times and circuit guide.`
  : `${seriesName} ${ev.title} ${ev.year} at ${where} — ${eventRange(ev)}. Session times, circuit guide and travel logistics.`;

const eventSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `${seriesName} — ${ev.title} ${ev.year}`,
  "startDate": ev.start ?? isoDay,
  "endDate": ev.end ?? isoDay,
  "url": canonical,
  "sport": "Motorsport",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "description": pageDescription,
  "image": ogPath(`events/${ev.year}/${ev.slug}`),
  "organizer": {
    "@type": "SportsOrganization",
    "name": seriesName,
    ...(seriesWeb ? { "url": seriesWeb } : {}),
  },
  "performer": {
    "@type": "SportsOrganization",
    "name": seriesName,
    ...(seriesWeb ? { "url": seriesWeb } : {}),
  },
  "location": venue ? {
    "@type": "Place",
    "name": venue.name,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": venue.city,
      "addressCountry": venue.country,
    },
    ...(venue.website ? { "url": venue.website } : {}),
  } : {
    "@type": "Place",
    "name": ev.title,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "ZZ",
    },
  },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dord.racing" },
    { "@type": "ListItem", "position": 2, "name": `${ev.year} Events`, "item": `https://dord.racing/events/${ev.year}` },
    { "@type": "ListItem", "position": 3, "name": `${ev.title} ${ev.year}`, "item": canonical },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonical}
  ogImage={ogPath(`events/${ev.year}/${ev.slug}`)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <Banner />
  <header>
    <div class="header--left">
      <h1>{sharedTitle && `${short} `}{ev.title}{monthTag}<br><span class="ev-year">{ev.year}</span></h1>
      <p class="header--page-desc">
        {seriesName}{venue ? ` · ${venue.name}, ${venue.country}` : ''}
      </p>
      <div class="meta">{eventRange(ev)} · SYSTEM TIMEZONE: PARIS (CET/CEST)</div>
      <Nav activePage="calendar" />
    </div>
  </header>

  <main id="main-content" class="event-page">

    <a href={`${base}/events/${ev.year}`} class="back-link">← {ev.year} Events</a>

    <div class="event-split">
      <div class="event-col-left">

        {track?.browserSvg && (
          <a href={`${base}/tracks/${track.slug}`} class="ev-hero" aria-label={`${track.name} circuit page`}>
            <img
              src={`${base}/track-svg/${track.browserSvg}`}
              alt={`${track.name} track layout`}
              width="880" height="528" loading="eager" decoding="async"
            />
          </a>
        )}

        <div class="ev-specs">
          <div class="ev-spec">
            <div class="spec-label">DATE</div>
            <div class="spec-value"><time datetime={isoDay}>{dateLong}</time></div>
          </div>
          <div class="ev-spec">
            <div class="spec-label">SERIES</div>
            <div class="spec-value">
              <a href={`${base}/series/${ev.series}`} class={`tag t-${ev.series}`}>{ev.tag}</a>
            </div>
          </div>
          {track ? (
            <div class="ev-spec">
              <div class="spec-label">CIRCUIT</div>
              <div class="spec-value">
                <a href={`${base}/tracks/${track.slug}`} class="ev-link">{track.name}</a>
              </div>
              <div class="spec-sub">{track.city} · {track.country}{track.length ? ` · ${track.length} km` : ''}</div>
            </div>
          ) : venue && (
            <div class="ev-spec">
              <div class="spec-label">{ev.trackSvg.endsWith('-wrc.svg') ? 'RALLY BASE' : 'CIRCUIT'}</div>
              <div class="spec-value">{venue.name}</div>
              <div class="spec-sub">{venue.city} · {venue.country}</div>
            </div>
          )}
        </div>

        <section class="ev-block ev-overview" aria-labelledby="ev-overview-h">
          <h2 class="section-label" id="ev-overview-h">OVERVIEW</h2>
          <p>{overview.join(' ')}</p>
        </section>

        <section class="ev-block" aria-labelledby="ev-sessions-h">
          <h2 class="section-label" id="ev-sessions-h">SESSION TIMES · PARIS (CET/CEST)</h2>
          <dl class="ev-sessions">
            {sessions.map(s => (
              <div class="ev-session">
                <dt>{s.label}</dt>
                <dd>{s.time ?? (timesTbc ? 'TBC' : '')}</dd>
              </div>
            ))}
          </dl>
          {ev.hasSprint && <p class="ev-note">Sprint weekend format.</p>}
          {worldTimes.length > 0 && (
            <div class="ev-world">
              <h3 class="ev-subhead">Race start around the world</h3>
              <table class="ev-world-table">
                <tbody>
                  {worldTimes.map(z => (
                    <tr class:list={{ 'is-local': z.local }}>
                      <th scope="row">{z.label}</th>
                      <td>{z.day}</td>
                      <td class="ev-world-time">{z.time} <span class="ev-world-abbr">{z.abbr}</span></td>
                    </tr>
                  ))}
                  <tr class="ev-world-yours" hidden>
                    <th scope="row">Your time</th>
                    <td class="js-your-day"></td>
                    <td class="ev-world-time js-your-time" data-iso={ev.date}></td>
                  </tr>
                </tbody>
              </table>
            </div>
          )}
          {ev.legs?.length && (
            <div class="ev-legs">
              {ev.legs.map(l => (
                <div class="ev-leg">
                  <span class="ev-leg-label">{l.label}</span>
                  <span class="ev-leg-time" set:html={l.time} />
                </div>
              ))}
            </div>
          )}
        </section>

        {ev.results?.length && (
          <div class="ev-block">
            <h2 class="section-label">RESULT</h2>
            <div class="ev-results">
              {ev.results.map((r: RaceResult) => (
                <div class="ev-result">
                  {r.race_label && <div class="res-label">{r.race_label}</div>}
                  {r.note && <div class="res-note">{r.note}</div>}
                  {winnerOf(r) && (
                    <div class="res-line">
                      <span class="res-winner">{winnerOf(r)}</span>
                      {r.country && <span class="res-flag" aria-hidden="true">{countryFlag(r.country)}</span>}
                    </div>
                  )}
                  {r.co_driver && <div class="res-sub">Co-driver: {r.co_driver}</div>}
                  {entrantOf(r) && <div class="res-sub">{entrantOf(r)}</div>}
                </div>
              ))}
            </div>
          </div>
        )}

        {watch.length > 0 && (
          <section class="ev-block" aria-labelledby="ev-watch-h">
            <h2 class="section-label" id="ev-watch-h">HOW TO WATCH</h2>
            <table class="ev-watch-table">
              <tbody>
                {watch.map(w => (
                  <tr>
                    <th scope="row">{w.country}</th>
                    <td>
                      <ul class="ev-watch-list">
                        {w.list.map(b => (
                          <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.name}</a> <span class="ev-watch-type">({TYPE_LABEL[b.type] ?? b.type}{b.note ? `, ${b.note}` : ''})</span></li>
                        ))}
                      </ul>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="ev-note">Broadcast rights change by season and region; check local listings.</p>
          </section>
        )}

        {ev.support?.length && (
          <div class="ev-block">
            <h2 class="section-label">SUPPORT RACES</h2>
            <div class="ev-support">
              {ev.support.map(s => (
                <div class="ev-support-row">
                  <span class={`badge b-${s.badge}`}>{s.label}</span>
                  <span class="ev-support-detail">{s.detail}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {alsoAtTrack.length > 0 && track && (
          <div class="ev-block">
            <h2 class="section-label">ALSO AT {track.name.toUpperCase()} IN {ev.year}</h2>
            <div class="ev-related">
              {alsoAtTrack.map(e => (
                <a href={`${base}${e.path}`} class="ev-related-row">
                  <span class="ev-related-date">{eventRange(e)}</span>
                  <span class={`tag t-${e.series}`}>{e.tag}</span>
                  <span class="ev-related-title">{e.title}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <nav class="ev-rounds" aria-label={`${seriesName} season navigation`}>
          {prevRound
            ? <a href={`${base}${prevRound.path}`} class="ev-round ev-round--prev">← {prevRound.title}</a>
            : <span class="ev-round ev-round--empty"></span>}
          {nextRound
            ? <a href={`${base}${nextRound.path}`} class="ev-round ev-round--next">{nextRound.title} →</a>
            : <span class="ev-round ev-round--empty"></span>}
        </nav>

      </div>

      <div class="event-col-right">
        {tickets.length > 0 && (
          <section class="ev-card ev-tickets" aria-labelledby="ev-tickets-h">
            <h2 class="section-label" id="ev-tickets-h">TICKETS</h2>
            <ul class="ev-tickets-list">
              {tickets.map(tk => (
                <li>
                  <a href={tk.url} target="_blank" rel={tk.partner ? PARTNER_REL : 'noopener noreferrer'} class="ev-ticket"
                     data-affiliate={tk.partner ? 'motorsport-tickets' : undefined}>
                    <span class="ev-ticket-name">{tk.name}</span>
                    <span class="ev-ticket-note">{tk.note}</span>
                    <span class="ev-ticket-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
            {tickets.some(tk => tk.partner) && (
              <p class="affiliate-notice">Motorsport Tickets is an affiliate link: we may earn a commission at no cost to you.</p>
            )}
          </section>
        )}
        {track?.logistics && <GettingThereCard logistics={track.logistics} />}
        {track && (
          <TripPlannerCard
            city={track.city}
            slug={track.slug}
            hotelQuery={accommodationQuery(track.logistics?.accommodation_hub, track.city)}
            placement={`event-${ev.slug}`}
          />
        )}
        <a class="ev-card ev-newsletter" href={`${base}/newsletter`}>
          <span class="section-label">NEWSLETTER</span>
          <span class="ev-newsletter-text">Every Monday: the week's races with start times, in one email.</span>
          <span class="ev-newsletter-cta">Sign up →</span>
        </a>
      </div>
    </div>

  </main>

  <Footer />
</BaseLayout>

<script>
  // Fill in the race start in the visitor's own timezone.
  const cell = document.querySelector<HTMLElement>('.js-your-time');
  if (cell?.dataset.iso) {
    const d = new Date(cell.dataset.iso);
    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
    cell.textContent = d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
    const day = document.querySelector('.js-your-day');
    if (day) day.textContent = d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    const row = cell.closest('tr');
    const th = row?.querySelector('th');
    if (th && tz) th.textContent = `Your time · ${tz.split('/').pop()!.replace(/_/g, ' ')}`;
    row?.removeAttribute('hidden');
  }
</script>

<style>
  .event-page {
    padding: 0 24px 80px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .ev-year { color: var(--text-meta); }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-meta);
    text-decoration: none;
    margin-bottom: 16px;
    letter-spacing: 0.06em;
  }
  .back-link:hover { color: var(--text-main); }

  .event-split {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .event-split { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .event-page { padding: 0 12px 60px; }
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .ev-hero {
    display: block;
    border: 1px solid var(--border);
    background: var(--card-bg);
    padding: 24px;
    margin-bottom: 2px;
    border-radius: var(--radius-2xl);
  }
  .ev-hero img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
  }

  /* ── Spec bar ─────────────────────────────────────────────────────────── */
  .ev-specs {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--border);
    border-top: none;
    background: var(--card-bg);
    margin-bottom: 2px;
    border-radius: var(--radius-2xl);
  }
  .ev-spec {
    padding: 16px 20px;
    border-right: 1px solid var(--border);
    flex: 1 1 180px;
    min-width: 0;
  }
  .ev-spec:last-child { border-right: none; }

  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    color: var(--text-meta);
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }
  .spec-value { font-size: var(--fs-lg); color: var(--text-soft); font-weight: 600; }
  .spec-sub {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs-3);
    color: var(--text-meta);
    margin-top: 4px;
  }
  .ev-link { color: var(--text-soft); text-decoration: none; }
  .ev-link:hover { text-decoration: underline; }
  .ev-specs .tag { text-decoration: none; font-size: var(--fs-2xs); padding: 3px 7px; }

  /* ── Blocks ───────────────────────────────────────────────────────────── */
  .ev-block {

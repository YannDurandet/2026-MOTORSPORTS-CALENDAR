    </div>

  </main>

  <Footer />
</BaseLayout>

<script>
  // How to watch: one country row shows by default (US, else the worldwide
  // row). "Use my location" swaps to the visitor's country — the same Cloudflare
  // IP lookup /watch uses, remembered on this device — and "See all" expands the
  // whole table, with "Show less" to pull it back to the single row.
  import { chooseCountry, detectCountry } from '../../../client/country.js';

  const rows = [...document.querySelectorAll<HTMLTableRowElement>('.ev-watch-table tr[data-code]')];
  const btnLoc = document.getElementById('ev-watch-loc') as HTMLButtonElement | null;
  const btnAll = document.getElementById('ev-watch-all') as HTMLButtonElement | null;
  const btnLess = document.getElementById('ev-watch-less') as HTMLButtonElement | null;

  if (rows.length > 1 && btnLoc && btnAll && btnLess) {
    const has = (code: string) => rows.some(r => r.dataset.code === code);
    let current = has('US') ? 'US' : has('global') ? 'global' : rows[0].dataset.code!;

    const collapse = () => {
      rows.forEach(r => { r.hidden = r.dataset.code !== current; });
      btnLoc.hidden = false;
      btnAll.hidden = false;
      btnLess.hidden = true;
    };
    const expand = () => {
      rows.forEach(r => { r.hidden = false; });
      btnLoc.hidden = true;
      btnAll.hidden = true;
      btnLess.hidden = false;
    };

    collapse();
    btnAll.addEventListener('click', expand);
    btnLess.addEventListener('click', collapse);
    btnLoc.addEventListener('click', async () => {
      btnLoc.disabled = true;
      try {
        const code = await detectCountry();
        if (code) {
          chooseCountry(code);
          current = has(code) ? code : 'global';
        }
      } finally {
        btnLoc.disabled = false;
      }
      collapse();
    });
  }
</script>


---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

import RoundsList from '../../components/RoundsList.astro';
import SeriesStandings from '../../components/SeriesStandings.astro';
import CountryDialog from '../../components/CountryDialog.astro';

import seriesContent from '../../../data/seriesContent.json';
import { currentSeason, seasonRounds, seriesSeasons, standingsSeason } from '../../lib/seriesSeasons';
import { seriesShort } from '../../lib/seriesShort';
import { seriesSeasonDescription } from '../../lib/seasonCopy';
import { fitTitle } from '../../lib/seo';
import { ogPath } from '../../lib/ogPaths';
import { jsonForScript } from '../../lib/jsonForScript';

export function getStaticPaths() {
  return (seriesContent as any[]).map((s: any) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const series = (seriesContent as any[]).find((s: any) => s.slug === slug)!;
const short = seriesShort(slug!, series.name);

// This hub shows one season of the series, chosen from the calendar on every
// build: the earliest that is not over yet (see lib/seriesSeasons.ts). Every
// season, this one included, also has its own page at /series/{slug}/{season}.
const year = currentSeason(slug!);
const rounds = seasonRounds(slug!, year);
const otherSeasons = seriesSeasons(slug!)
  .filter(s => s !== year)
  .map(s => ({ season: s, count: seasonRounds(slug!, s).length, past: s < year }));
// "& Standings" in the title only while the tables are this season's.
const hasStandings = standingsSeason(slug!) === year;
// The teams table is typed by hand for one season (seriesContent.json → teamsSeason).
const teamsSeason: number = (series as any).teamsSeason ?? year;

const sportsOrgSchema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "name": series.name,
  "sport": "Motorsport",
  "description": series.description,
  ...(series.socials?.web ? { "url": series.socials.web } : {}),
  "sameAs": [
    series.socials?.web,
    series.socials?.x,
    series.socials?.ig,
    series.socials?.yt,
  ].filter(Boolean),
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dord.racing" },
    { "@type": "ListItem", "position": 2, "name": "Racing Series", "item": "https://dord.racing/series" },
    { "@type": "ListItem", "position": 3, "name": series.name, "item": `https://dord.racing/series/${slug}` },
  ],
};

// The rounds, in order, pointing at their event pages. Each event page carries
// the full SportsEvent markup, so it is not repeated here.
const roundsSchema = rounds.length ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${series.name} ${year} calendar`,
  "numberOfItems": rounds.length,
  "itemListElement": rounds.map((ev, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": `${ev.title} ${ev.year}`,
    "url": `https://dord.racing${ev.path}`,
  })),
} : null;

// Before the season's first result the page is a calendar, and is titled like
// the season page it stands in for (that title is what "{series} {year}
// calendar" searches found). Once rounds have been run it names the results.
const raced = rounds.filter(r => r.results?.length).length;
const pageTitle = raced > 0 || rounds.length === 0
  ? `${short} ${year} Calendar, Results${hasStandings ? ' & Standings' : ''} | DORD`
  : fitTitle([
      `${short} ${year} Calendar — ${rounds.length} Rounds, Dates & Venues | DORD`,
      `${short} ${year} Calendar — ${rounds.length} Rounds & Dates | DORD`,
      `${short} ${year} Calendar | DORD`,
    ]);
const pageDescription = seriesSeasonDescription(slug!, year, short, rounds, series.tagline);
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`https://dord.racing/series/${slug}`}
  ogImage={ogPath(`series/${slug}`)}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonForScript(sportsOrgSchema)} />
    <script type="application/ld+json" set:html={jsonForScript(breadcrumbSchema)} />
    {roundsSchema && <script type="application/ld+json" set:html={jsonForScript(roundsSchema)} />}
  </Fragment>
  <Banner />
  <header>
    <div class="header--left">
      <h1>{series.name}<br><span class="h1-sub">{year} Calendar{raced > 0 || rounds.length === 0 ? <> &amp; Results</> : ''}</span></h1>
      <div class="meta">SYSTEM TIMEZONE: PARIS (CET/CEST)</div>
      <Nav activePage="series" />
    </div>
  </header>

  <main id="main-content" class="main-section main-section--content">
    <a href={`${base}/`} class="back-link">← Full Master Calendar</a>

    <div class={`series-hero series-hero--${slug}`}>
      <div class="series-hero-accent" style={`background: var(--${slug})`}></div>
      <div class="series-hero-content">
        <div class="series-badges">
          <span class="series-badge">{series.category}</span>
          <span class="series-badge">{series.region}</span>
        </div>
        <p class="series-hero-name">{series.name}</p>
        <p class="series-description">{series.description}</p>
        {series.socials && (
          <div class="series-socials">
            {series.socials.web && (
              <a href={series.socials.web} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Official website">
                <img src={`${base}/assets/website-icon.svg`} alt="" width="18" height="18" />
              </a>
            )}
            {series.socials.ig && (
              <a href={series.socials.ig} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
                <img src={`${base}/assets/ig-icon.svg`} alt="" width="18" height="18" />
              </a>
            )}
            {series.socials.x && (
              <a href={series.socials.x} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="X">
                <img src={`${base}/assets/x-icon.svg`} alt="" width="18" height="18" />
              </a>
            )}
            {series.socials.yt && (
              <a href={series.socials.yt} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="YouTube">
                <img src={`${base}/assets/yt-icon.svg`} alt="" width="18" height="18" />
              </a>
            )}
          </div>
        )}
      </div>
    </div>

    <section class="series-section">
      <h2 class="series-section-title">History</h2>
      <p class="series-history">{series.history}</p>
    </section>

    {(series as any).howToWatch && (
      <section class="series-section" id="htw-section">
        <h2 class="series-section-title">How to Watch</h2>
        <div
          id="htw-root"
          data-htw={JSON.stringify((series as any).howToWatch)}
          aria-live="polite"
        ></div>
        <!-- Outside #htw-root so re-rendering the pills never drops keyboard focus -->
        <button type="button" id="htw-change" class="country-link" hidden></button>
        <p class="htw-disclaimer">Broadcast rights vary by region. Check local listings.</p>
        <CountryDialog />
      </section>
    )}

    {series.tier === 1 && series.teamsHeaders && (
      <section class="series-section">
        <h2 class="series-section-title">Teams &amp; Drivers — {teamsSeason}</h2>
        {series.seasonNotes && <p class="series-season-notes">{series.seasonNotes}</p>}
        <div class="series-table-wrap" tabindex="0" role="region" aria-label="Teams and drivers table">
          <table class="series-table">
            <thead>
              <tr>
                {(series.teamsHeaders as string[]).map((h: string) => <th>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {(series.teamsRows as string[][]).map((row: string[]) => (
                <tr>
                  {row.map((cell: string) => <td>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {series.teamsNote && <p class="series-table-note">{series.teamsNote}</p>}
      </section>
    )}

    {hasStandings && <SeriesStandings slug={slug!} shownSeason={year} />}

    <section class="series-section" id="calendar">
      <h2 class="series-section-title">{year} Calendar</h2>
      {rounds.length === 0
        ? <p class="series-no-events">No events found for this series.</p>
        : <>
            <p class="series-cal-note">{rounds.length} rounds · times are Paris (CET/CEST) · select a round for session times, how to watch and travel.</p>
            <RoundsList events={rounds} label={`${series.name} ${year} rounds`} />
          </>}
      {otherSeasons.filter(o => !o.past).map(o => (
        <a class="season-next-link" href={`${base}/series/${slug}/${o.season}`}>
          {short} {o.season} calendar — {o.count} rounds announced →
        </a>
      ))}
    </section>

    {/* Last season's closing standings, once the hub has moved on to the next calendar. */}
    {!hasStandings && <SeriesStandings slug={slug!} shownSeason={year} />}

    {otherSeasons.some(o => o.past) && (
      <nav class="series-section season-archive" aria-label={`Earlier ${short} seasons`}>
        {otherSeasons.filter(o => o.past).map(o => (
          <a class="season-next-link" href={`${base}/series/${slug}/${o.season}`}>
            {short} {o.season} season — calendar and results of all {o.count} rounds →
          </a>
        ))}
      </nav>
    )}

    <section class="series-section">
      <h2 class="series-section-title">Subscribe &amp; Embed</h2>
      <div class="subscribe-actions">
        <a
          href={`webcal://dord.racing/ical/${slug}.ics`}
          class="subscribe-btn subscribe-btn--ical"
          aria-label={`Subscribe to ${series.name} calendar`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Subscribe (iCal)
        </a>
        <a
          href={`https://calendar.google.com/calendar/render?cid=webcal://dord.racing/ical/${slug}.ics`}
          target="_blank"
          rel="noopener noreferrer"
          class="subscribe-btn subscribe-btn--gcal"
          aria-label={`Add ${series.name} to Google Calendar`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          + Google Calendar
        </a>
        <button
          class="subscribe-btn subscribe-btn--embed"
          id="embed-btn"
          aria-haspopup="dialog"
          data-slug={slug}
          data-name={series.name}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          Embed
        </button>
      </div>
    </section>

    <!-- Embed modal -->
    <div id="embed-modal" class="embed-modal" role="dialog" aria-modal="true" aria-labelledby="embed-modal-title" hidden>
      <div class="embed-modal-backdrop"></div>
      <div class="embed-modal-box">
        <div class="embed-modal-header">
          <h4 class="embed-modal-title" id="embed-modal-title" aria-level="2">Embed the calendar</h4>
          <button class="embed-modal-close" aria-label="Close embed modal">&times;</button>
        </div>
        <p class="embed-modal-desc">Copy this snippet to embed a live race calendar on any website.</p>
        <pre id="embed-code" class="embed-code-block"></pre>
        <div class="embed-modal-actions">
          <button class="embed-copy-btn" id="embed-copy-btn">Copy code</button>
          <span class="embed-checks">✓ Auto-updates &nbsp; ✓ Free &nbsp; ✓ Links to dord.racing</span>
        </div>
      </div>
    </div>

    <a href={`${base}/`} class="back-link back-link--bottom">← Full Master Calendar</a>

  </main>
  <Footer />
</BaseLayout>

<script>
import {
  CHANGE_EVENT, getChoice, pickBroadcasters, regionLabel,
  openCountryDialog, initCountryDialog,
} from '../../scripts/country.js';

// ── How to Watch ───────────────────────────────────────────────
(function () {
  const root = document.getElementById('htw-root');
  if (!root) return;

  const raw = root.getAttribute('data-htw');
  if (!raw) return;

  let data: Record<string, { name: string; type: string; url: string; note?: string }[]>;
  try { data = JSON.parse(raw); } catch { return; }

  const section = document.getElementById('htw-section');
  const changeBtn = document.getElementById('htw-change');

  // Which country's list to show is the visitor's choice (the popup on /watch or
  // the button below), not a guess from the browser language.
  // See src/scripts/country.js.
  function render() {
    const choice = getChoice();
    const { list, scope, code } = pickBroadcasters(data, choice);
    if (section) section.hidden = list.length === 0;
    if (!list.length) return;

    const chosen = choice.state === 'chosen';
    let label: string;
    if (scope === 'country') {
      label = `Watch in <span class="htw-country">${regionLabel(code)}</span>${chosen ? '' : ' (default)'}`;
    } else if (chosen && code !== 'global') {
      label = `No local listing for <span class="htw-country">${regionLabel(code)}</span>. Worldwide option`;
    } else {
      label = 'Watch globally';
    }

    const pills = list.map((b: { name: string; type?: string; url: string; note?: string }) => {
      const badgeHtml = b.type === 'free'
        ? '<span class="htw-badge htw-badge--free">FREE</span>'
        : b.type === 'streaming'
        ? '<span class="htw-badge htw-badge--stream">STREAM</span>'
        : '';
      const noteHtml = b.note ? `<span class="htw-note">${b.note}</span>` : '';
      return `<a href="${b.url}" target="_blank" rel="noopener noreferrer" class="htw-pill">${b.name}${badgeHtml}${noteHtml}</a>`;
    }).join('');

    root!.innerHTML = `<p class="htw-label">${label}</p><div class="htw-pills">${pills}</div>`;

    if (changeBtn) {
      changeBtn.textContent = chosen ? 'Change country' : 'Not in the US? Set your country';
      changeBtn.hidden = false;
    }
  }

  changeBtn?.addEventListener('click', openCountryDialog);
  window.addEventListener(CHANGE_EVENT, render);
  initCountryDialog();
  render();
})();

// ── Embed Modal ────────────────────────────────────────────────
(function () {
  const btn = document.getElementById('embed-btn') as HTMLButtonElement | null;
  const modal = document.getElementById('embed-modal') as HTMLElement | null;
  const closeBtn = modal?.querySelector('.embed-modal-close') as HTMLButtonElement | null;
  const backdrop = modal?.querySelector('.embed-modal-backdrop') as HTMLElement | null;
  const codeEl = document.getElementById('embed-code') as HTMLElement | null;
  const copyBtn = document.getElementById('embed-copy-btn') as HTMLButtonElement | null;

  if (!btn || !modal || !codeEl) return;

  const slug = btn.dataset.slug || '';
  const name = btn.dataset.name || 'Racing';
  const iframeCode = `<iframe\n  src="https://dord.racing/embed/${slug}"\n  width="100%"\n  height="400"\n  frameborder="0"\n  style="border-radius:8px;"\n  title="${name} Race Calendar — DORD Racing"\n></iframe>\n<p style="font-size:11px;text-align:right">\n  <a href="https://dord.racing" target="_blank" rel="noopener">Full calendar at dord.racing ↗</a>\n</p>`;
  codeEl.textContent = iframeCode;

  function openModal() {
    modal!.hidden = false;
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }
  function closeModal() {
    modal!.hidden = true;
    document.body.style.overflow = '';
    btn!.focus();
  }

  btn.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  modal?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeModal();
  });

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(iframeCode).then(() => {
      copyBtn.textContent = 'Copied!';
      setTimeout(() => { copyBtn.textContent = 'Copy code'; }, 2000);
    });
  });
})();
</script>
